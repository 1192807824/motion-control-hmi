<Window x:Class="VisionMasterHost.RealtimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VMControls.WPF.Release;assembly=VMControls.WPF.Release"
        Title="VisionMaster 实时画面"
        Width="800"
        Height="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#202427"
        Loaded="RealtimeWindow_Loaded"
        Closing="RealtimeWindow_Closing">
    <Grid Background="#202427">
        <vm:VmRenderControl x:Name="RealtimeRenderControl"
                            CoordinateInfoVisible="False"
                            OnMouseLeftButtonDownPixelChanged="RealtimeRenderControl_OnMouseLeftButtonDownPixelChanged" />

        <Grid IsHitTestVisible="False" Panel.ZIndex="20">
            <Border Width="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="#FF00E676" />
            <Border Height="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="#FF00E676" />
        </Grid>

        <Border x:Name="ErrorPanel"
                Visibility="Collapsed"
                Background="#E6202427"
                Panel.ZIndex="30">
            <TextBlock x:Name="ErrorTextBlock"
                       Margin="30"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#FF6B73"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
