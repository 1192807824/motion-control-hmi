<Window x:Class="VisionMasterHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VMControls.WPF.Release;assembly=VMControls.WPF.Release"
        mc:Ignorable="d"
        Title="VisionMaster 视觉标定"
        Width="1540"
        Height="760"
        MinWidth="1024"
        MinHeight="640"
        Background="#111D29"
        FontFamily="Microsoft YaHei UI"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0D6EE8" />
            <Setter Property="BorderBrush" Value="#0B5CC2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="Selector" TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#F7FAFC" />
            <Setter Property="Foreground" Value="#10263A" />
            <Setter Property="BorderBrush" Value="#668198" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AFC0CE" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="14,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid Background="#111D29">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="CommandBar"
                Grid.Row="0"
                Padding="12,10"
                Background="#163047"
                BorderBrush="#345269"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="185" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="235" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SolutionPathTextBox"
                             Height="34"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             IsReadOnly="True"
                             Background="#F7FAFC"
                             Foreground="#263746"
                             BorderBrush="#668198"
                             BorderThickness="1"
                             Text="未选择方案"
                             ToolTip="当前 VisionMaster .sol 方案" />
                    <Button Grid.Column="1"
                            x:Name="ChooseSolutionButton"
                            Content="选择方案"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="92"
                            Click="ChooseSolution_Click" />
                </Grid>

                <TextBlock Grid.Column="1" Text="流程" Style="{StaticResource FieldLabel}" />
                <ComboBox Grid.Column="2"
                          x:Name="ProcedureComboBox"
                          Style="{StaticResource Selector}"
                          IsEnabled="False"
                          ToolTip="选择要运行的流程"
                          SelectionChanged="ProcedureComboBox_SelectionChanged" />

                <TextBlock Grid.Column="3" Text="图像步骤" Style="{StaticResource FieldLabel}" />
                <ComboBox Grid.Column="4"
                          x:Name="ImageStepComboBox"
                          Style="{StaticResource Selector}"
                          DisplayMemberPath="DisplayName"
                          IsEnabled="False"
                          ToolTip="仅显示这个步骤的图像与绘制结果"
                          SelectionChanged="ImageStepComboBox_SelectionChanged" />

                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <Button x:Name="RunOnceButton"
                            Content="运行一次"
                            Style="{StaticResource PrimaryButton}"
                            Background="#17834A"
                            BorderBrush="#12683A"
                            IsEnabled="False"
                            Click="RunOnce_Click" />
                    <Button x:Name="ContinuousRunButton"
                            Content="实时预览"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="False"
                            Click="ContinuousRun_Click" />
                    <Button x:Name="StopRunButton"
                            Content="暂停预览"
                            Style="{StaticResource PrimaryButton}"
                            Background="#D90D16"
                            BorderBrush="#A90A12"
                            IsEnabled="False"
                            Click="StopRun_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Padding="14,0"
                Background="#13283A"
                BorderBrush="#345269"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusIndicator" Width="9" Height="9" Fill="#E0A21A" />
                <TextBlock x:Name="StatusTextBlock"
                           Margin="8,0,0,0"
                           Text="请选择方案；加载后将自动开启实时预览"
                           Foreground="#D8E4EC"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="10"
                Background="#202427"
                BorderBrush="#345269"
                BorderThickness="1"
                CornerRadius="5"
                ClipToBounds="True">
            <Grid>
                <vm:VmRenderControl x:Name="VisionRenderControl"
                                    CoordinateInfoVisible="True" />

                <StackPanel x:Name="ImagePlaceholder"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <Border Width="70"
                            Height="70"
                            CornerRadius="35"
                            Background="#263A4B">
                        <TextBlock Text="▣"
                                   Foreground="#6E879A"
                                   FontSize="34"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Margin="0,18,0,0"
                               Text="选择标定方案后显示步骤图像"
                               Foreground="#AAB9C6"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Margin="0,6,0,0"
                               Text="程序会记住当前方案、流程和图像步骤"
                               Foreground="#71889A"
                               FontSize="12"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Border x:Name="SdkErrorPanel"
                        Visibility="Collapsed"
                        Background="#EC202427">
                    <Border Width="620"
                            Padding="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#163047"
                            BorderBrush="#D90D16"
                            BorderThickness="2"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="VisionMaster SDK 初始化失败"
                                       Foreground="#FFFFFF"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="SdkErrorTextBlock"
                                       Margin="0,14,0,0"
                                       Foreground="#F2C7C9"
                                       FontSize="14"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,14,0,0"
                                       Text="请确认 VisionMaster 4.4 已安装并激活、加密狗可用，关闭其他 VisionMaster 程序后再重启视觉组件。"
                                       Foreground="#AAB9C6"
                                       FontSize="13"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
