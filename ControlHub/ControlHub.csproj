
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <NoWarn>$(NoWarn);NU1702</NoWarn>
    <!-- F5 must run the copy target even when only the external vision host changed. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlashCap" Version="1.11.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.20" />
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VisionMasterHost\VisionMasterHost.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="VisionMasterHostTargetPath" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="motion-settings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Native\x86\LTDMC.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          TargetPath="LTDMC.dll" />
  </ItemGroup>

  <Target Name="CollectVisionMasterHostFiles" DependsOnTargets="ResolveProjectReferences">
    <!-- Use the referenced project's actual output, including its VS platform and OutputPath.
         A hard-coded bin/$(Configuration)/net48 path can silently copy an older executable. -->
    <Error Condition="'@(VisionMasterHostTargetPath)' == ''"
           Text="未获得本次 VisionMasterHost 编译输出，请重新生成整个解决方案。" />
    <PropertyGroup>
      <_VisionMasterHostOutputDirectory>@(VisionMasterHostTargetPath->'%(RootDir)%(Directory)')</_VisionMasterHostOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
      <VisionMasterHostFiles Include="$(_VisionMasterHostOutputDirectory)**\*"
                             Exclude="$(_VisionMasterHostOutputDirectory)VisionMasterHost\**\*" />
    </ItemGroup>
    <Error Condition="!Exists('%(VisionMasterHostTargetPath.FullPath)')"
           Text="VisionMasterHost 编译文件不存在：%(VisionMasterHostTargetPath.FullPath)。请启用视觉项目的生成并重新生成解决方案。" />
    <Message Importance="High" Text="复制本次视觉程序：@(VisionMasterHostTargetPath) -> $(OutDir)VisionMasterHost\" />
  </Target>

  <Target Name="CopyVisionMasterHost" AfterTargets="Build" DependsOnTargets="CollectVisionMasterHostFiles">
    <Copy SourceFiles="@(VisionMasterHostFiles)"
          DestinationFiles="@(VisionMasterHostFiles->'$(OutDir)VisionMasterHost\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyVisionMasterHostToPublish" AfterTargets="Publish" DependsOnTargets="CollectVisionMasterHostFiles">
    <Copy SourceFiles="@(VisionMasterHostFiles)"
          DestinationFiles="@(VisionMasterHostFiles->'$(PublishDir)VisionMasterHost\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
