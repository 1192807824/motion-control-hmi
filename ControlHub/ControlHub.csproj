<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <NoWarn>$(NoWarn);NU1702</NoWarn>
    <!--
      ControlHub 固定为 x86，但 VisionMasterHost 的 PlatformTarget 固定为 x64。
      当父工程以 /p:Platform=x86 构建时，MSBuild 仍会把宿主输出到 bin\x86；
      这里按实际 Platform 选择目录，避免复制到旧的 bin\Debug 宿主。
    -->
    <VisionMasterHostOutputDirectory
      Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">$(MSBuildProjectDirectory)\..\VisionMasterHost\bin\$(Configuration)\net48</VisionMasterHostOutputDirectory>
    <VisionMasterHostOutputDirectory
      Condition="'$(Platform)' != '' And '$(Platform)' != 'AnyCPU'">$(MSBuildProjectDirectory)\..\VisionMasterHost\bin\$(Platform)\$(Configuration)\net48</VisionMasterHostOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VisionMasterHost\VisionMasterHost.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="motion-settings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Native\x86\LTDMC.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          TargetPath="LTDMC.dll" />
  </ItemGroup>

  <Target Name="CopyVisionMasterHost" AfterTargets="Build">
    <ItemGroup>
      <VisionMasterHostFiles Include="$(VisionMasterHostOutputDirectory)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(VisionMasterHostFiles)"
          DestinationFiles="@(VisionMasterHostFiles->'$(OutDir)VisionMasterHost\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyVisionMasterHostToPublish" AfterTargets="Publish">
    <ItemGroup>
      <VisionMasterHostPublishFiles Include="$(VisionMasterHostOutputDirectory)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(VisionMasterHostPublishFiles)"
          DestinationFiles="@(VisionMasterHostPublishFiles->'$(PublishDir)VisionMasterHost\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
