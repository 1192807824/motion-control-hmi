<Window x:Class="ControlHub.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:pages="clr-namespace:ControlHub.Views.Pages"
        Title="新纳摆盘机"
        Width="1680"
        Height="950"
        MinWidth="1280"
        MinHeight="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        Background="#D7DDE5"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="TopBar" Color="#071827" />
        <SolidColorBrush x:Key="TopBar2" Color="#12283E" />
        <SolidColorBrush x:Key="MenuBlue" Color="#1F5F9F" />

        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Foreground" Value="#EAF2FA" />
            <Setter Property="Background" Value="#20384F" />
            <Setter Property="BorderBrush" Value="#7D98B1" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#284A68" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#17324A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveMenuButton" TargetType="Button" BasedOn="{StaticResource MenuButton}">
            <Setter Property="Background" Value="{StaticResource MenuBlue}" />
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Foreground" Value="#EAF2FA" />
            <Setter Property="Background" Value="#132F49" />
            <Setter Property="BorderBrush" Value="#46637E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1F5F9F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0E2438" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#E8EDF2">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource TopBar}" BorderBrush="#25435E" BorderThickness="0,0,0,1">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="560" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="480" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="118"
                               Height="29"
                               Margin="0,0,14,0"
                               Source="/Assets/Icons/Brand/logo.png"
                               Stretch="Uniform" />
                        <TextBlock Text="新纳芯片测试" Foreground="White" FontSize="25" FontWeight="Bold" />
                        <Border Width="1" Height="24" Background="#44627D" Margin="20,0,18,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="当前配方" Foreground="#AFC1D2" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="产品A_20240520" Foreground="#F2F7FB" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="运行状态：" Foreground="#E8F0F7" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="运行中" Foreground="#00FF4C" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,42,0" />
                        <TextBlock Text="急停状态：" Foreground="#E8F0F7" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="正常" Foreground="#00FF4C" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="38" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding UserPermissionText}" Foreground="#F2F7FB" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="{Binding NowText}" Foreground="#F2F7FB" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" FontSize="15" FontWeight="Bold" />
                        <Button Grid.Column="2" Content="-" Style="{StaticResource WindowButton}" ToolTip="最小化" Click="MinimizeWindow_Click" />
                        <Button Grid.Column="3" Content="□" Style="{StaticResource WindowButton}" ToolTip="全屏/还原" Click="ToggleWindowSize_Click" />
                        <Button Grid.Column="4" Content="×" Style="{StaticResource WindowButton}" ToolTip="关闭" Click="CloseWindow_Click" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource TopBar2}" Padding="0,4,14,4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource MenuButton}">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="20"
                                   Height="20"
                                   Margin="0,0,8,0"
                                   Source="/Assets/Icons/TopMenu/home.png"
                                   Stretch="Uniform" />
                            <TextBlock Text="主页" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MotionMenuButton" Style="{StaticResource ActiveMenuButton}" Click="MotionMenu_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="20"
                                   Height="20"
                                   Margin="0,0,8,0"
                                   Source="/Assets/Icons/TopMenu/motion-control.png"
                                   Stretch="Uniform" />
                            <TextBlock Text="运动控制" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="VisionMenuButton" Style="{StaticResource MenuButton}" Click="VisionMenu_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="20"
                                   Height="20"
                                   Margin="0,0,8,0"
                                   Source="/Assets/Icons/TopMenu/ccd.png"
                                   Stretch="Uniform" />
                            <TextBlock Text="机器视觉" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ConnectionMenuButton" Style="{StaticResource MenuButton}" Click="ConnectionMenu_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="20"
                                   Height="20"
                                   Margin="0,0,8,0"
                                   Source="/Assets/Icons/TopMenu/system-settings.png"
                                   Stretch="Uniform" />
                            <TextBlock Text="&#x8FDE;&#x63A5;&#x914D;&#x7F6E;" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButton}">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="20"
                                   Height="20"
                                   Margin="0,0,8,0"
                                   Source="/Assets/Icons/TopMenu/system-settings.png"
                                   Stretch="Uniform" />
                            <TextBlock Text="参数设置" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButton}">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="20"
                                   Height="20"
                                   Margin="0,0,8,0"
                                   Source="/Assets/Icons/TopMenu/alarm-records.png"
                                   Stretch="Uniform" />
                            <TextBlock Text="报警记录" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuButton}" Click="PermissionLogin_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="20"
                                   Height="20"
                                   Margin="0,0,8,0"
                                   Source="/Assets/Icons/TopMenu/permission-login.png"
                                   Stretch="Uniform" />
                            <TextBlock Text="权限登录" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <pages:MotionControlPage x:Name="MotionPage"
                                     Grid.Row="2" />

            <pages:MachineVisionPage x:Name="VisionContent"
                                     Grid.Row="2"
                                     Margin="10,10,10,8"
                                     Visibility="Collapsed" />

            <pages:ConnectionConfigPage x:Name="ConnectionConfigContent"
                                        Grid.Row="2"
                                        Visibility="Collapsed" />
    </Grid>
</Window>
