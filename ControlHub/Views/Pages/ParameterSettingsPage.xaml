<UserControl x:Class="ControlHub.Views.Pages.ParameterSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1680"
             d:DesignHeight="854"
             Background="#0F2335"
             FontFamily="Microsoft YaHei UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#162E43" />
        <SolidColorBrush x:Key="PanelBorder" Color="#345269" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F2F6F9" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9FB1BF" />
        <SolidColorBrush x:Key="AccentBlue" Color="#1F75C8" />

    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="参数设置"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="24"
                               FontWeight="Bold" />
                    <TextBlock Text="集中管理生产位置、运动速度与 Z 轴高度"
                               Margin="0,5,0,0"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#143B35"
                            BorderBrush="#28725C"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12,5"
                            Margin="0,0,10,0">
                        <TextBlock Text="修改自动保存"
                                   Foreground="#49D17D"
                                   FontSize="12"
                                   FontWeight="Bold" />
                    </Border>
                    <Border Background="#183955"
                            BorderBrush="#35688F"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12,5">
                        <TextBlock Text="单位：pulse / pulse·s⁻¹ / ms"
                                   Foreground="#77BEFF"
                                   FontSize="12"
                                   FontWeight="Bold" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Border Background="#12283A"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <ContentControl x:Name="SettingsContentHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
