<UserControl x:Class="ControlHub.Views.Pages.MotionControlPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="680"
             PreviewMouseDown="MotionControlPage_PreviewMouseDown"
             Unloaded="MotionControlPage_Unloaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBorder" Color="#B9C1CB" />
        <SolidColorBrush x:Key="PanelTitle" Color="#003B73" />
        <SolidColorBrush x:Key="DarkText" Color="#101827" />

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#F3F6FA" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PanelTitle}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#C9D7E4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.24" Color="#334155" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AxisButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="#EEF2F6" />
            <Setter Property="BorderBrush" Value="#CBD2DA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E1E7ED" />
                                <Setter Property="BorderBrush" Value="#AEB8C3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D6DEE7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IoTabButton" TargetType="Button">
            <Setter Property="BorderBrush" Value="#B9C1CB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#F0F3F6" />
            <Setter Property="Foreground" Value="#101827" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="{StaticResource DarkText}" />
            <Setter Property="BorderBrush" Value="#CBD2DA" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="#CDD3DA" />
            <Setter Property="VerticalGridLinesBrush" Value="#CDD3DA" />
            <Setter Property="RowBackground" Value="#F8FAFC" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="RowHeight" Value="31" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF2F6" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#CBD2DA" />
            <Setter Property="BorderThickness" Value="0,1,1,1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CenteredDataGridText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="LeftDataGridText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="Padding" Value="6,0,2,0" />
        </Style>

        <Style x:Key="AxisNameText" TargetType="TextBlock" BasedOn="{StaticResource CenteredDataGridText}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Name}" />
        </Style>

        <Style x:Key="AxisNameEditor" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="2,0" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="132" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10,10,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.55*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="0.72*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Border x:Name="AxisStatusPanel" Grid.Column="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{Binding MotionAxisSummaryText}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding MotionConnectionText}"
                                   Margin="12,1,0,0"
                                   Foreground="#526477"
                                   FontSize="12"
                                   VerticalAlignment="Top" />
                    </DockPanel>
                    <DataGrid x:Name="AxisDataGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding Axes}"
                              SelectedItem="{Binding SelectedAxis}"
                              IsReadOnly="False"
                              CanUserSortColumns="False"
                              AlternationCount="2"
                              AlternatingRowBackground="#F8FAFC"
                              RowHeight="34"
                              CellEditEnding="AxisDataGrid_CellEditEnding"
                              Loaded="AxisDataGrid_Loaded"
                              SizeChanged="AxisDataGrid_LayoutChanged"
                              LostKeyboardFocus="AxisDataGrid_LostKeyboardFocus"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="轴号" Binding="{Binding AxisNo}" Width="0.55*" ElementStyle="{StaticResource CenteredDataGridText}" IsReadOnly="True" />
                            <DataGridTextColumn Header="轴名称"
                                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                Width="1.25*"
                                                MinWidth="120"
                                                ElementStyle="{StaticResource AxisNameText}"
                                                EditingElementStyle="{StaticResource AxisNameEditor}" />
                            <DataGridTextColumn Header="当前位置" Binding="{Binding DisplayPosition}" Width="1.14*" ElementStyle="{StaticResource CenteredDataGridText}" IsReadOnly="True" />
                            <DataGridTextColumn Header="目标位置" Binding="{Binding DisplayTarget}" Width="1.14*" ElementStyle="{StaticResource CenteredDataGridText}" IsReadOnly="True" />
                            <DataGridTextColumn Header="速度" Binding="{Binding DisplaySpeed}" Width="1.1*" ElementStyle="{StaticResource CenteredDataGridText}" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="点动速度" Width="0.86*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Width="58"
                                                 Height="24"
                                                 Padding="4,0"
                                                 VerticalContentAlignment="Center"
                                                 TextAlignment="Center"
                                                 LostFocus="AxisSettingsTextBox_LostFocus"
                                                 Text="{Binding JogSpeed, UpdateSourceTrigger=LostFocus, StringFormat=0.###}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="点动距离" Width="0.86*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Width="58"
                                                 Height="24"
                                                 Padding="4,0"
                                                 VerticalContentAlignment="Center"
                                                 TextAlignment="Center"
                                                 LostFocus="AxisSettingsTextBox_LostFocus"
                                                 Text="{Binding JogDistance, UpdateSourceTrigger=LostFocus, StringFormat=0.###}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="伺服状态" Width="0.88*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Fill="{Binding ServoBrush}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding ServoText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="伺服操作" Width="1.16*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Content="使能"
                                                    Style="{StaticResource AxisButton}"
                                                    IsEnabled="{Binding CanServoOn}"
                                                    Click="ServoOn_Click" />
                                            <Button Content="解除"
                                                    Style="{StaticResource AxisButton}"
                                                    Margin="6,0,0,0"
                                                    IsEnabled="{Binding CanServoOff}"
                                                    Click="ServoOff_Click" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="报警状态" Width="0.86*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" Fill="{Binding AlarmBrush}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding AlarmText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="正限位" Width="0.57*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="12" Height="12" Fill="{Binding PositiveLimitBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="负限位" Width="0.57*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="12" Height="12" Fill="{Binding NegativeLimitBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="回零" Width="0.62*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="回零"
                                                Style="{StaticResource AxisButton}"
                                                IsEnabled="{Binding CanMove}"
                                                ToolTip="{Binding State}"
                                                Click="Home_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="点动+" Width="0.66*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="点动+"
                                                Style="{StaticResource AxisButton}"
                                                IsEnabled="{Binding CanMove}"
                                                ToolTip="{Binding State}"
                                                Click="JogPositive_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="点动-" Width="0.66*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="点动-"
                                                Style="{StaticResource AxisButton}"
                                                IsEnabled="{Binding CanMove}"
                                                ToolTip="{Binding State}"
                                                Click="JogNegative_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="停止" Width="0.62*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="停止"
                                                Style="{StaticResource AxisButton}"
                                                IsEnabled="{Binding IsAvailable}"
                                                ToolTip="{Binding State}"
                                                Click="Stop_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="292" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="■ I/O监控" Style="{StaticResource SectionTitle}" />
                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,6">
                            <Button x:Name="DigitalInputTab"
                                    Content="数字输入(X)"
                                    Tag="DigitalInput"
                                    IsEnabled="{Binding MotionControlsEnabled}"
                                    Style="{StaticResource IoTabButton}"
                                    Click="IoMode_Click" />
                            <Button x:Name="DigitalOutputTab"
                                    Content="数字输出(Y)"
                                    Tag="DigitalOutput"
                                    IsEnabled="{Binding MotionControlsEnabled}"
                                    Style="{StaticResource IoTabButton}"
                                    Click="IoMode_Click" />
                            <Button x:Name="AnalogInputTab"
                                    Content="模拟输入(AI)"
                                    Tag="AnalogInput"
                                    IsEnabled="{Binding MotionControlsEnabled}"
                                    Style="{StaticResource IoTabButton}"
                                    Click="IoMode_Click" />
                            <Button x:Name="AnalogOutputTab"
                                    Content="模拟输出(AO)"
                                    Tag="AnalogOutput"
                                    IsEnabled="{Binding MotionControlsEnabled}"
                                    Style="{StaticResource IoTabButton}"
                                    Click="IoMode_Click" />
                        </UniformGrid>
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding IoPoints}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" Rows="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,5" />
                                        <Ellipse Width="15"
                                                 Height="15"
                                                 Fill="{Binding LampBrush}"
                                                 Stroke="#6B7280"
                                                 StrokeThickness="1"
                                                 Visibility="{Binding DigitalInputVisibility}" />
                                        <Button Width="42"
                                                Height="23"
                                                Padding="2,0"
                                                Content="{Binding DigitalOutputText}"
                                                Background="{Binding LampBrush}"
                                                Foreground="White"
                                                FontWeight="Bold"
                                                Visibility="{Binding DigitalOutputVisibility}"
                                                Click="DigitalOutput_Click" />
                                        <TextBlock Text="{Binding DisplayValue}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Visibility="{Binding AnalogInputVisibility}" />
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding AnalogOutputVisibility}">
                                            <TextBox Width="52"
                                                     Height="23"
                                                     Padding="2,0"
                                                     VerticalContentAlignment="Center"
                                                     TextAlignment="Center"
                                                     Text="{Binding Value, UpdateSourceTrigger=LostFocus, StringFormat=0.###}" />
                                            <Button Width="30"
                                                    Height="23"
                                                    Margin="3,0,0,0"
                                                    Padding="1,0"
                                                    Content="写"
                                                    Click="AnalogOutput_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="■ 报警记录" Style="{StaticResource SectionTitle}" FontSize="14" />
                        <DataGrid x:Name="AlarmDataGrid"
                                  Grid.Row="1"
                                  ItemsSource="{Binding AlarmRecords}"
                                  RowHeight="29"
                                  FontSize="11"
                                  LostKeyboardFocus="AlarmDataGrid_LostKeyboardFocus">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="1.35*" MinWidth="128" ElementStyle="{StaticResource LeftDataGridText}" />
                                <DataGridTextColumn Header="报警代码" Binding="{Binding Code}" Width="0.9*" ElementStyle="{StaticResource LeftDataGridText}" />
                                <DataGridTextColumn Header="报警信息" Binding="{Binding Message}" Width="2.1*" ElementStyle="{StaticResource LeftDataGridText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="OperationPanel"
                Grid.Row="1"
                Background="#F8FAFC"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                Margin="10,4,10,8"
                Padding="16,6,14,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="■ 操作面板" Style="{StaticResource SectionTitle}" Margin="0" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,10,0">
                        <Button Background="#168500"
                                IsEnabled="{Binding MotionControlsEnabled}"
                                Style="{StaticResource ActionButton}"
                                Click="ServoAllOn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="24"
                                       Height="24"
                                       Margin="0,0,8,0"
                                       Source="/Assets/Icons/ControlPanel/start.png"
                                       Stretch="Uniform" />
                                <TextBlock Text="全使能" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Background="#5F6B7A"
                                IsEnabled="{Binding MotionControlsEnabled}"
                                Style="{StaticResource ActionButton}"
                                Click="ServoAllOff_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="24"
                                       Height="24"
                                       Margin="0,0,8,0"
                                       Source="/Assets/Icons/ControlPanel/stop.png"
                                       Stretch="Uniform" />
                                <TextBlock Text="全解除" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Background="#BC100B"
                                IsEnabled="{Binding MotionControlsEnabled}"
                                Style="{StaticResource ActionButton}"
                                Click="StopAll_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="24"
                                       Height="24"
                                       Margin="0,0,8,0"
                                       Source="/Assets/Icons/ControlPanel/stop.png"
                                       Stretch="Uniform" />
                                <TextBlock Text="全轴急停" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="HomeAllButton"
                                Background="#E97906"
                                IsEnabled="{Binding MotionControlsEnabled}"
                                Style="{StaticResource ActionButton}"
                                Click="HomeAll_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="24"
                                       Height="24"
                                       Margin="0,0,8,0"
                                       Source="/Assets/Icons/ControlPanel/home.png"
                                       Stretch="Uniform" />
                                <TextBlock Text="顺序回原点" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Background="#1F5F9F"
                                IsEnabled="{Binding MotionControlsEnabled}"
                                Style="{StaticResource ActionButton}"
                                Click="ClearAlarm_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="24"
                                       Height="24"
                                       Margin="0,0,8,0"
                                       Source="/Assets/Icons/ControlPanel/clear-alarm.png"
                                       Stretch="Uniform" />
                                <TextBlock Text="报警清除" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
