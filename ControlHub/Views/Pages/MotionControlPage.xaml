<UserControl x:Class="ControlHub.Views.Pages.MotionControlPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1680"
             d:DesignHeight="850"
             Background="#10263A"
             Unloaded="MotionControlPage_Unloaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PageBackground" Color="#10263A" />
        <SolidColorBrush x:Key="PanelBackground" Color="#163047" />
        <SolidColorBrush x:Key="PanelBackgroundAlt" Color="#1B374F" />
        <SolidColorBrush x:Key="PanelBorder" Color="#345269" />
        <SolidColorBrush x:Key="PrimaryBlue" Color="#0D6EE8" />
        <SolidColorBrush x:Key="PrimaryBlueHover" Color="#2384F3" />
        <SolidColorBrush x:Key="MutedText" Color="#AAB9C6" />
        <SolidColorBrush x:Key="LightText" Color="#F4F8FB" />
        <SolidColorBrush x:Key="DangerRed" Color="#D90D16" />
        <SolidColorBrush x:Key="SuccessGreen" Color="#39C56B" />

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LightText}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MutedLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#10263A" />
            <Setter Property="Background" Value="#F7FAFC" />
            <Setter Property="BorderBrush" Value="#7F96A8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#294A64" />
            <Setter Property="BorderBrush" Value="#45647A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#365C78" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#63B3FF" />
                                <Setter Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeTab" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Height" Value="54" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="#233D55" />
        </Style>

        <Style x:Key="JogHoldButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Height" Value="168" />
            <Setter Property="Background" Value="#0C4C88" />
            <Setter Property="BorderBrush" Value="#2877B8" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="Padding" Value="18,10" />
        </Style>

        <Style x:Key="StatusRowLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedLabel}">
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="StatusValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#62B5FF" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource LightText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,18,0" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource LightText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource LightText}" />
            <Setter Property="Background" Value="#162F45" />
        </Style>

        <Style x:Key="AxisCardItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#27445C" />
            <Setter Property="BorderBrush" Value="#3B5A70" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#31536E" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#0D6EE8" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#53A8FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#173047" />
            <Setter Property="Foreground" Value="#EAF1F7" />
            <Setter Property="BorderBrush" Value="#345269" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#345269" />
            <Setter Property="RowBackground" Value="#173047" />
            <Setter Property="AlternatingRowBackground" Value="#1A344B" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="RowHeight" Value="28" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#213E56" />
            <Setter Property="Foreground" Value="#F4F8FB" />
            <Setter Property="BorderBrush" Value="#345269" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="30" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="571" />
            <RowDefinition Height="250" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="2.3*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="0.75*" MinWidth="260" MaxWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}">
                            <Run Text="轴列表  " /><Run Text="{Binding Axes.Count, Mode=OneWay}" /><Run Text=" 轴" />
                        </TextBlock>
                        <TextBlock Text="{Binding MotionDetectedCardsText}" ToolTip="{Binding MotionDetectedCardsText}" Foreground="#62B5FF" FontSize="9" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ListBox x:Name="AxisSelector"
                             Grid.Row="1"
                             ItemsSource="{Binding Axes}"
                             SelectedItem="{Binding SelectedAxis, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource AxisCardItem}"
                             SelectionChanged="AxisSelector_SelectionChanged"
                             VerticalAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="28" Margin="8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="66" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding HardwareAxisNo}"
                                               Foreground="White"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                             IsReadOnly="True"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             Foreground="White"
                                             FontSize="13"
                                             FontWeight="Bold"
                                             VerticalContentAlignment="Center"
                                             InputMethod.IsInputMethodEnabled="True"
                                             ToolTip="双击修改轴名称"
                                             MouseDoubleClick="AxisName_MouseDoubleClick"
                                             LostFocus="AxisName_LostFocus"
                                             KeyDown="AxisName_KeyDown">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsReadOnly" Value="False">
                                                        <Setter Property="Cursor" Value="IBeam" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{Binding State}">
                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding CardStateText}" Foreground="#D8E4EC" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>
            </Border>

            <Grid Grid.Column="2" Grid.ColumnSpan="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="458" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="105" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="54" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="#345269" BorderThickness="0,0,0,1" Padding="14,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="当前轴：" Foreground="#D8E4EC" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedAxis.Name, TargetNullValue=--}" Foreground="White" FontSize="20" FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedAxis.HardwareAxisNo, StringFormat=  （硬件轴 {0}）}" Foreground="#9DB1C1" FontSize="13" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="伺服使能" Style="{StaticResource FlatButton}" Background="#168A37" Margin="0,0,8,0" IsEnabled="{Binding SelectedAxis.CanServoOn}" Click="ServoOn_Click" />
                                <Button Content="解除使能" Style="{StaticResource FlatButton}" IsEnabled="{Binding SelectedAxis.CanServoOff}" Click="ServoOff_Click" />
                                <Button Content="全部使能"
                                        Style="{StaticResource FlatButton}"
                                        Background="#168A37"
                                        Margin="16,0,8,0"
                                        AutomationProperties.Name="使能全部硬件轴"
                                        ToolTip="确认机构安全后，逐轴使能控制卡检测到且配置允许的全部硬件轴。"
                                        Click="ServoAllOn_Click" />
                                <Button Content="关闭所有使能"
                                        Style="{StaticResource FlatButton}"
                                        Background="#B45309"
                                        AutomationProperties.Name="关闭全部硬件轴使能"
                                        ToolTip="仅在全部硬件轴均已停止并确认后，逐轴解除使能。"
                                        Click="ServoAllOff_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="FixedModeTab" Grid.Column="0" Content="定距定位" Tag="FixedPosition" Style="{StaticResource ModeTab}" Click="ModeTab_Click" />
                        <Button x:Name="JogModeTab" Grid.Column="1" Content="连续 JOG" Tag="ContinuousJog" Style="{StaticResource ModeTab}" Click="ModeTab_Click" />
                        <Button x:Name="HomeModeTab" Grid.Column="2" Content="回原点" Tag="Home" Style="{StaticResource ModeTab}" Click="ModeTab_Click" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="10">
                        <Grid x:Name="JogModePanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="92" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="JogNegativeButton" Grid.Row="0" Grid.Column="0"
                                    Tag="-1"
                                    AutomationProperties.Name="按住负向连续运行，松开减速停止"
                                    Style="{StaticResource JogHoldButton}"
                                    IsEnabled="{Binding SelectedAxis.CanJogHoldInput}"
                                    PreviewMouseLeftButtonDown="JogHold_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="JogHold_PreviewMouseLeftButtonUp"
                                    MouseLeave="JogHold_MouseLeave"
                                    LostMouseCapture="JogHold_LostMouseCapture"
                                    LostKeyboardFocus="JogHold_LostKeyboardFocus"
                                    PreviewKeyDown="JogHold_PreviewKeyDown"
                                    PreviewKeyUp="JogHold_PreviewKeyUp">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Width="64" Height="64" Source="/Assets/Icons/Motion/jog-arrow-v2.png" Margin="0,0,16,0" RenderTransformOrigin="0.5,0.5">
                                            <Image.RenderTransform><ScaleTransform ScaleX="-1" /></Image.RenderTransform>
                                    </Image>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="负向 JOG" FontSize="20" FontWeight="Bold" />
                                        <TextBlock Text="按住运行 · 松开停止" Foreground="#BFD7E8" FontSize="11" Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Border Grid.Row="0" Grid.Column="1"
                                    Margin="20,28"
                                    Padding="16"
                                    VerticalAlignment="Center"
                                    Background="#1A344B"
                                    BorderBrush="#345269"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="JOG 速度" Foreground="#D8E4EC" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBox Text="{Binding SelectedAxis.JogSpeed, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}"
                                             Style="{StaticResource InputBox}"
                                             IsEnabled="{Binding SelectedAxis.CanEditMotionParameters}"
                                             FontSize="22"
                                             Height="46"
                                             Margin="0,10,0,8"
                                             TextAlignment="Center"
                                             HorizontalContentAlignment="Center"
                                             LostFocus="AxisSettingsTextBox_LostFocus" />
                                    <TextBlock Text="units（脉冲）/s" Foreground="#AFC0CD" FontSize="12" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Button x:Name="JogPositiveButton" Grid.Row="0" Grid.Column="2"
                                    Tag="1"
                                    AutomationProperties.Name="按住正向连续运行，松开减速停止"
                                    Style="{StaticResource JogHoldButton}"
                                    IsEnabled="{Binding SelectedAxis.CanJogHoldInput}"
                                    PreviewMouseLeftButtonDown="JogHold_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="JogHold_PreviewMouseLeftButtonUp"
                                    MouseLeave="JogHold_MouseLeave"
                                    LostMouseCapture="JogHold_LostMouseCapture"
                                    LostKeyboardFocus="JogHold_LostKeyboardFocus"
                                    PreviewKeyDown="JogHold_PreviewKeyDown"
                                    PreviewKeyUp="JogHold_PreviewKeyUp">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="正向 JOG" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" />
                                        <TextBlock Text="按住运行 · 松开停止" Foreground="#BFD7E8" FontSize="11" Margin="0,4,0,0" />
                                    </StackPanel>
                                        <Image Width="64" Height="64" Source="/Assets/Icons/Motion/jog-arrow-v2.png" Margin="16,0,0,0" />
                                </StackPanel>
                            </Button>

                            <Border Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Margin="20,8,20,0"
                                    Padding="24,14,24,0"
                                    BorderBrush="#345269"
                                    BorderThickness="0,1,0,0">
                                <Grid MaxWidth="780" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource FlatButton}" Height="56" Background="#405A70" AutomationProperties.Name="当前运动轴减速停止" Click="LocalStop_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Width="26" Height="26" Source="/Assets/Icons/Motion/deceleration-stop.png" Margin="0,0,9,0" />
                                        <TextBlock Text="单轴减速停" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="JogImmediateStopButton" Grid.Column="2" Style="{StaticResource FlatButton}" Height="56" Background="#C86508" AutomationProperties.Name="当前运动轴立即停止" Click="ImmediateStop_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Width="25" Height="25" Source="/Assets/Icons/Motion/emergency-stop.png" Margin="0,0,8,0" />
                                        <TextBlock Text="单轴立即停" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="4" Style="{StaticResource FlatButton}" Height="56" Background="{StaticResource DangerRed}" AutomationProperties.Name="全轴急停" Click="StopAll_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Width="25" Height="25" Source="/Assets/Icons/Motion/emergency-stop.png" Margin="0,0,8,0" />
                                        <TextBlock Text="全轴急停" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="FixedModePanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#1A344B" BorderBrush="#345269" BorderThickness="1" CornerRadius="3" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="44" />
                                        <RowDefinition Height="44" />
                                        <RowDefinition Height="44" />
                                        <RowDefinition Height="44" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="定距定位参数" Style="{StaticResource SectionTitle}" />
                                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                                        <TextBlock Text="坐标方式" Style="{StaticResource MutedLabel}" Width="90" />
                                        <RadioButton x:Name="RelativeModeRadio" Content="相对位置" IsChecked="True" Checked="RelativeMode_Checked" />
                                        <RadioButton x:Name="AbsoluteModeRadio" Content="绝对位置" Checked="AbsoluteMode_Checked" />
                                    </StackPanel>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="MoveValueLabel" Text="移动距离" Style="{StaticResource MutedLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedAxis.JogDistance, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" Style="{StaticResource InputBox}" IsEnabled="{Binding SelectedAxis.CanEditMotionParameters}" LostFocus="AxisSettingsTextBox_LostFocus" />
                                        <TextBlock Grid.Column="2" Text="{Binding SelectedAxis.Unit}" Foreground="#AFC0CD" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="运行速度" Style="{StaticResource MutedLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedAxis.JogSpeed, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" Style="{StaticResource InputBox}" IsEnabled="{Binding SelectedAxis.CanEditMotionParameters}" LostFocus="AxisSettingsTextBox_LostFocus" />
                                        <TextBlock Grid.Column="2" Foreground="#AFC0CD" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Run Text="units（脉冲）/s" />
                                        </TextBlock>
                                    </Grid>
                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Grid.ColumnSpan="2" Content="等待运动完成" IsChecked="{Binding Tuning.WaitForCompletion, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" Click="MotionProfile_Changed" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="超时" Foreground="#AFC0CD" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox Width="88" Text="{Binding Tuning.CompletionTimeoutMilliseconds, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" LostFocus="MotionProfile_LostFocus" />
                                            <TextBlock Text="ms" Foreground="#AFC0CD" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="58" />
                                    <RowDefinition Height="66" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button x:Name="RelativeNegativeButton" Grid.Column="0" Tag="-1" Style="{StaticResource JogHoldButton}" Height="126" IsEnabled="{Binding SelectedAxis.CanMove}" AutomationProperties.Name="相对负向移动" Click="FixedMove_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Width="70" Height="70" Source="/Assets/Icons/Motion/jog-arrow-v2.png" Margin="0,0,12,0" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><ScaleTransform ScaleX="-1" /></Image.RenderTransform></Image>
                                        <TextBlock Text="负向定距" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RelativePositiveButton" Grid.Column="2" Tag="1" Style="{StaticResource JogHoldButton}" Height="126" IsEnabled="{Binding SelectedAxis.CanMove}" AutomationProperties.Name="相对正向移动" Click="FixedMove_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="正向定距" VerticalAlignment="Center" />
                                        <Image Width="70" Height="70" Source="/Assets/Icons/Motion/jog-arrow-v2.png" Margin="12,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="AbsoluteTargetButton" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource JogHoldButton}" Height="126" Visibility="Collapsed" IsEnabled="{Binding SelectedAxis.CanMove}" AutomationProperties.Name="移动到绝对目标位置" Click="AbsoluteMove_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="移动到目标位置" VerticalAlignment="Center" />
                                        <Image Width="64" Height="64" Source="/Assets/Icons/Motion/absolute-target-v2.png" Margin="14,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="#1A344B" BorderBrush="#345269" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="到位误差" Foreground="#AFC0CD" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBox Width="92" Text="{Binding Tuning.CompletionTolerance, ElementName=Root, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" Style="{StaticResource InputBox}" LostFocus="MotionProfile_LostFocus" />
                                        <TextBlock Text="{Binding SelectedAxis.Unit}" Foreground="#AFC0CD" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource FlatButton}" Height="58" Background="#52697B" AutomationProperties.Name="当前运动轴减速停止" Click="LocalStop_Click">
                                        <TextBlock Text="单轴减速停" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                    </Button>
                                    <Button x:Name="FixedImmediateStopButton" Grid.Column="2" Style="{StaticResource FlatButton}" Height="58" Background="#E97906" AutomationProperties.Name="当前运动轴立即停止" Click="ImmediateStop_Click">
                                        <TextBlock Text="单轴立即停" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Grid.Column="4" Style="{StaticResource FlatButton}" Height="58" Background="{StaticResource DangerRed}" AutomationProperties.Name="全轴急停" Click="StopAll_Click">
                                        <TextBlock Text="全轴急停" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Grid>

                        <Grid x:Name="HomeModePanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                            <Border Background="#1A344B" BorderBrush="#345269" BorderThickness="1" CornerRadius="3" Padding="16" Margin="0,0,14,0">
                                <Grid x:Name="HomeEditorPanel">
                                    <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Content="启用当前轴回零" IsChecked="{Binding HomeTuning.Enabled, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Click="HomeProfile_Changed" />
                                        <TextBlock Text="当前轴回零参数" Style="{StaticResource SectionTitle}" FontSize="18" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <UniformGrid Grid.Row="1" Columns="4" Rows="2" Height="150" VerticalAlignment="Top" Margin="-6,14,-6,0">
                                        <StackPanel Margin="6"><TextBlock Text="回零模式" Style="{StaticResource MutedLabel}" /><TextBox Text="{Binding HomeTuning.Mode, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" ToolTip="支持 -32768～65535；负数会按 16 位补码下发给控制卡。" LostFocus="HomeProfile_Changed" /></StackPanel>
                                        <StackPanel Margin="6"><TextBlock Text="低速 (units（脉冲）/s)" Style="{StaticResource MutedLabel}" /><TextBox Text="{Binding HomeTuning.LowVelocity, ElementName=Root, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" Style="{StaticResource InputBox}" LostFocus="HomeProfile_Changed" /></StackPanel>
                                        <StackPanel Margin="6"><TextBlock Text="高速 (units（脉冲）/s)" Style="{StaticResource MutedLabel}" /><TextBox Text="{Binding HomeTuning.HighVelocity, ElementName=Root, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" Style="{StaticResource InputBox}" LostFocus="HomeProfile_Changed" /></StackPanel>
                                        <StackPanel Margin="6"><TextBlock Style="{StaticResource MutedLabel}"><Run Text="偏移 (" /><Run Text="{Binding SelectedAxis.Unit}" /><Run Text=")" /></TextBlock><TextBox Text="{Binding HomeTuning.OffsetPosition, ElementName=Root, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" Style="{StaticResource InputBox}" LostFocus="HomeProfile_Changed" /></StackPanel>
                                        <StackPanel Margin="6"><TextBlock Text="加速时间 (ms)" Style="{StaticResource MutedLabel}" /><TextBox Text="{Binding HomeTuning.AccelerationMilliseconds, ElementName=Root, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" Style="{StaticResource InputBox}" LostFocus="HomeProfile_Changed" /></StackPanel>
                                        <StackPanel Margin="6"><TextBlock Text="减速时间 (ms)" Style="{StaticResource MutedLabel}" /><TextBox Text="{Binding HomeTuning.DecelerationMilliseconds, ElementName=Root, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" Style="{StaticResource InputBox}" LostFocus="HomeProfile_Changed" /></StackPanel>
                                        <StackPanel Margin="6"><TextBlock Text="全局超时 (s)" Style="{StaticResource MutedLabel}" /><TextBox Text="{Binding HomeTuning.TimeoutSeconds, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" LostFocus="HomeProfile_Changed" /></StackPanel>
                                        <StackPanel Margin="6"><TextBlock Text="回零次序 (0=不参与)" Style="{StaticResource MutedLabel}" /><TextBox Text="{Binding HomeTuning.SequenceOrder, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" ToolTip="1 最先，2 第二，依次类推；0 不参加顺序回原点。" LostFocus="HomeProfile_Changed" /></StackPanel>
                                    </UniformGrid>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button x:Name="HomeCurrentButton" Content="当前轴回原点" Style="{StaticResource FlatButton}" Height="62" Background="#E97906" ToolTip="{Binding SelectedAxis.HomeConfigurationSummary}" Click="Home_Click" />
                                <Button x:Name="HomeAllButton" Content="按次序回原点" Style="{StaticResource FlatButton}" Height="52" Margin="0,12,0,0" Click="HomeAll_Click" />
                                <Button x:Name="TestOneKeyResetButton" Content="一键复位测试" Style="{StaticResource FlatButton}" Height="52" Margin="0,12,0,0" Background="#B45309" IsEnabled="False" AutomationProperties.Name="按固定测试参数执行一键复位" ToolTip="R速度50000、Z速度10000同时 → 上料X速度100000 → 上料Y、下料XY与测试站13/14/15速度100000同时 → DD马达速度50000" Click="TestOneKeyReset_Click" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="单轴减速停" Style="{StaticResource FlatButton}" Height="52" Background="#52697B" AutomationProperties.Name="当前运动轴减速停止" Click="LocalStop_Click" />
                                    <Button x:Name="HomeImmediateStopButton" Grid.Column="2" Content="单轴立即停" Style="{StaticResource FlatButton}" Height="52" Background="#E97906" AutomationProperties.Name="当前运动轴立即停止" Click="ImmediateStop_Click" />
                                </Grid>
                                <Button Content="全轴急停" Style="{StaticResource FlatButton}" Height="52" Margin="0,12,0,0" Background="{StaticResource DangerRed}" AutomationProperties.Name="全轴急停" Click="StopAll_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Style="{StaticResource Panel}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="56" />
                        <RowDefinition Height="56" />
                        <RowDefinition Height="56" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="实时状态" Style="{StaticResource SectionTitle}" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="当前位置" Style="{StaticResource StatusRowLabel}" />
                        <Grid Grid.Column="1" Margin="6,3,0,3">
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="14" /></Grid.RowDefinitions>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="CurrentPositionValue" Text="{Binding SelectedAxis.DisplayPosition, TargetNullValue=--}" ToolTip="{Binding SelectedAxis.DisplayPosition}" Style="{StaticResource StatusValue}" />
                            </Viewbox>
                            <TextBlock Grid.Row="1" Text="{Binding SelectedAxis.Unit}" Foreground="#B9C9D5" FontSize="10" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="目标位置" Style="{StaticResource StatusRowLabel}" />
                        <Grid Grid.Column="1" Margin="6,3,0,3">
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="14" /></Grid.RowDefinitions>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TargetPositionValue" Text="{Binding SelectedAxis.DisplayTarget, TargetNullValue=--}" ToolTip="{Binding SelectedAxis.DisplayTarget}" Style="{StaticResource StatusValue}" />
                            </Viewbox>
                            <TextBlock Grid.Row="1" Text="{Binding SelectedAxis.Unit}" Foreground="#B9C9D5" FontSize="10" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="当前速度" Style="{StaticResource StatusRowLabel}" />
                        <Grid Grid.Column="1" Margin="6,3,0,3">
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="14" /></Grid.RowDefinitions>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="CurrentSpeedValue" Text="{Binding SelectedAxis.DisplaySpeed, TargetNullValue=--}" ToolTip="{Binding SelectedAxis.DisplaySpeed}" Style="{StaticResource StatusValue}" />
                            </Viewbox>
                            <TextBlock Grid.Row="1" Text="units（脉冲）/s" Foreground="#B9C9D5" FontSize="10" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                    <Border Grid.Row="4" Background="#345269" />
                    <StackPanel Grid.Row="5" Margin="0,8,0,0">
                        <Grid Height="34">
                            <TextBlock Text="总线状态" Style="{StaticResource StatusRowLabel}" />
                            <TextBlock Text="{Binding MotionConnectionText}" ToolTip="{Binding MotionConnectionText}" Foreground="#62B5FF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Width="170" />
                        </Grid>
                        <Grid Height="30"><TextBlock Text="伺服使能" Style="{StaticResource StatusRowLabel}" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Ellipse Width="11" Height="11" Fill="{Binding SelectedAxis.ServoBrush}" Margin="0,0,8,0" /><TextBlock Text="{Binding SelectedAxis.ServoText}" Foreground="#E8F0F5" VerticalAlignment="Center" /></StackPanel></Grid>
                        <Grid Height="30"><TextBlock Text="报警状态" Style="{StaticResource StatusRowLabel}" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Ellipse Width="11" Height="11" Fill="{Binding SelectedAxis.AlarmBrush}" Margin="0,0,8,0" /><TextBlock Text="{Binding SelectedAxis.AlarmText}" Foreground="#E8F0F5" VerticalAlignment="Center" /></StackPanel></Grid>
                        <Grid Height="30"><TextBlock Text="回零状态" Style="{StaticResource StatusRowLabel}" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Ellipse Width="11" Height="11" Fill="{Binding SelectedAxis.HomedBrush}" Margin="0,0,8,0" /><TextBlock Text="{Binding SelectedAxis.HomedText}" Foreground="#E8F0F5" VerticalAlignment="Center" /></StackPanel></Grid>
                        <Grid Height="30"><TextBlock Text="正限位" Style="{StaticResource StatusRowLabel}" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Ellipse Width="11" Height="11" Fill="{Binding SelectedAxis.PositiveLimitBrush}" Margin="0,0,8,0" /><TextBlock Text="{Binding SelectedAxis.PositiveLimitText}" Foreground="#E8F0F5" VerticalAlignment="Center" /></StackPanel></Grid>
                        <Grid Height="30"><TextBlock Text="负限位" Style="{StaticResource StatusRowLabel}" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Ellipse Width="11" Height="11" Fill="{Binding SelectedAxis.NegativeLimitBrush}" Margin="0,0,8,0" /><TextBlock Text="{Binding SelectedAxis.NegativeLimitText}" Foreground="#E8F0F5" VerticalAlignment="Center" /></StackPanel></Grid>
                        <Grid Height="40" Margin="0,6,0,0"><TextBlock Text="命令状态" Style="{StaticResource StatusRowLabel}" VerticalAlignment="Top" /><TextBlock x:Name="CommandStateText" Text="准备" Foreground="#62B5FF" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Width="170" /></Grid>
                        <Grid Height="30"><TextBlock Text="运行时间" Style="{StaticResource StatusRowLabel}" /><TextBlock x:Name="CommandElapsedText" Text="00:00:00.000" Foreground="#E8F0F5" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Expander Grid.Row="2" Grid.Column="0" IsExpanded="True" Background="#162F45" BorderBrush="#345269" BorderThickness="1">
                <Expander.Header>
                    <TextBlock Foreground="#E6EEF4" Margin="8,5">
                        <Run Text="运动参数" FontWeight="Bold" />
                        <Run Text="  ·  速度单位：units（脉冲）/s" Foreground="#8FA7B8" FontSize="11" />
                    </TextBlock>
                </Expander.Header>
                <Grid Margin="10,8" IsEnabled="{Binding SelectedAxis.CanEditMotionParameters}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="起始速度" Style="{StaticResource MutedLabel}" /><TextBox Text="{Binding Tuning.StartVelocity, ElementName=Root, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" Style="{StaticResource InputBox}" LostFocus="MotionProfile_LostFocus" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="运行速度" Style="{StaticResource MutedLabel}" /><TextBox Text="{Binding SelectedAxis.JogSpeed, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" Style="{StaticResource InputBox}" LostFocus="AxisSettingsTextBox_LostFocus" /></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="停止速度" Style="{StaticResource MutedLabel}" /><TextBox Text="{Binding Tuning.StopVelocity, ElementName=Root, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" Style="{StaticResource InputBox}" LostFocus="MotionProfile_LostFocus" /></StackPanel>
                    <StackPanel Grid.Column="6"><TextBlock Text="加速时间 (ms)" Style="{StaticResource MutedLabel}" /><TextBox Text="{Binding Tuning.AccelerationMilliseconds, ElementName=Root, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" Style="{StaticResource InputBox}" LostFocus="MotionProfile_LostFocus" /></StackPanel>
                    <StackPanel Grid.Column="8"><TextBlock Text="减速时间 (ms)" Style="{StaticResource MutedLabel}" /><TextBox Text="{Binding Tuning.DecelerationMilliseconds, ElementName=Root, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" Style="{StaticResource InputBox}" LostFocus="MotionProfile_LostFocus" /></StackPanel>
                    <StackPanel Grid.Column="10"><TextBlock Text="S 曲线时间 (ms)" Style="{StaticResource MutedLabel}" /><TextBox Text="{Binding Tuning.STimeMilliseconds, ElementName=Root, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" Style="{StaticResource InputBox}" LostFocus="MotionProfile_LostFocus" /></StackPanel>
                    <StackPanel Grid.Column="12"><TextBlock Text="减速停止时间 (ms)" Style="{StaticResource MutedLabel}" /><TextBox Text="{Binding Tuning.DecelerationStopMilliseconds, ElementName=Root, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" Style="{StaticResource InputBox}" LostFocus="MotionProfile_LostFocus" /></StackPanel>
                    <StackPanel Grid.Column="14">
                        <TextBlock Text="操作" Style="{StaticResource MutedLabel}" />
                        <Button Content="恢复默认" Style="{StaticResource FlatButton}" Height="32" Padding="4,0" Click="ResetProfile_Click" />
                    </StackPanel>
                </Grid>
            </Expander>
        </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="DigitalInputTab" Content="数字输入 (X)" Tag="DigitalInput" Style="{StaticResource FlatButton}" Height="28" Margin="0,0,4,0" Click="IoMode_Click" />
                        <Button x:Name="DigitalOutputTab" Content="数字输出 (Y)" Tag="DigitalOutput" Style="{StaticResource FlatButton}" Height="28" Margin="0,0,4,0" Click="IoMode_Click" />
                        <Button x:Name="AnalogInputTab" Content="模拟输入" Tag="AnalogInput" Style="{StaticResource FlatButton}" Height="28" Margin="0,0,4,0" Click="IoMode_Click" />
                        <Button x:Name="AnalogOutputTab" Content="模拟输出" Tag="AnalogOutput" Style="{StaticResource FlatButton}" Height="28" Click="IoMode_Click" />
                    </StackPanel>
                    <ItemsControl x:Name="IoItemsControl" Grid.Row="1" ItemsSource="{Binding IoPoints}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="8" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                             IsReadOnly="True"
                                             MaxLength="12"
                                             Height="18"
                                             Padding="0"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="#C9D6DF"
                                             FontSize="9"
                                             FontWeight="SemiBold"
                                             TextAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             HorizontalContentAlignment="Center"
                                             ToolTip="{Binding NameEditToolTip}"
                                             MouseDoubleClick="IoName_MouseDoubleClick"
                                             LostFocus="IoName_LostFocus"
                                             KeyDown="IoName_KeyDown" />

                                    <Ellipse Grid.Row="1"
                                             Visibility="{Binding DigitalInputVisibility}"
                                             Width="13"
                                             Height="13"
                                             Fill="{Binding LampBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />

                                    <Button Grid.Row="1"
                                            Visibility="{Binding DigitalOutputVisibility}"
                                            Tag="{Binding Channel}"
                                            Content="{Binding DigitalOutputText}"
                                            Style="{StaticResource FlatButton}"
                                            Height="24"
                                            Padding="2"
                                            FontSize="9"
                                            Click="DigitalOutput_Click" />

                                    <TextBlock Grid.Row="1"
                                               Visibility="{Binding AnalogInputVisibility}"
                                               Text="{Binding DisplayValue}"
                                               Foreground="White"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />

                                    <StackPanel Grid.Row="1"
                                                Visibility="{Binding AnalogOutputVisibility}"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBox Width="36" Height="22" Text="{Binding Value, UpdateSourceTrigger=LostFocus, StringFormat=0.###}" TextAlignment="Center" FontSize="9" Padding="1" />
                                        <Button Content="写入" Style="{StaticResource FlatButton}" Height="22" Padding="3,0" Margin="3,0,0,0" FontSize="9" Click="AnalogOutput_Click" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel><TextBlock Text="报警记录（最近）" Style="{StaticResource SectionTitle}" /><Button Content="清除报警" Style="{StaticResource FlatButton}" Height="26" HorizontalAlignment="Right" Click="ClearAlarm_Click" /></DockPanel>
                    <DataGrid x:Name="AlarmDataGrid" Grid.Row="1" ItemsSource="{Binding AlarmRecords}" Margin="0,6,0,0" LostKeyboardFocus="AlarmDataGrid_LostKeyboardFocus">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="160" />
                            <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="120" />
                            <DataGridTextColumn Header="报警信息" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

        </Grid>

        <DataGrid x:Name="AxisDataGrid" Visibility="Collapsed" ItemsSource="{Binding Axes}" SelectedItem="{Binding SelectedAxis}" />

        <Border x:Name="AxisSwitchOverlay"
                Grid.RowSpan="2"
                Panel.ZIndex="100"
                Background="#9910263A"
                Visibility="Collapsed"
                AutomationProperties.Name="正在切换轴，请稍候">
            <Border Width="340"
                    Padding="28,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F2163047"
                    BorderBrush="#62B5FF"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="正在切换轴"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="正在载入运动参数，请稍候…"
                               Foreground="#AFC0CD"
                               FontSize="12"
                               Margin="0,7,0,16"
                               HorizontalAlignment="Center" />
                    <ProgressBar x:Name="AxisSwitchProgressBar"
                                 Height="6"
                                 IsIndeterminate="True"
                                 IsHitTestVisible="False"
                                 Foreground="#62B5FF"
                                 Background="#294A64" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
