                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource SuccessGreen}" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="已就绪" Foreground="#D8E4EB" FontSize="12" VerticalAlignment="Center" /></StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="3" BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="视觉系统" Style="{StaticResource MutedLabel}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Ellipse x:Name="VisionCalibrationStatusIndicator"
                                                 Width="7"
                                                 Height="7"
                                                 Fill="#F2B544"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="VisionCalibrationStatusText"
                                                   Text="标定状态检查中"
                                                   Foreground="#D8E4EB"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="132" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StartProductionButton"
                                Style="{StaticResource OperationButton}"
                                Background="#168B50"
                                BorderBrush="#38B979"
                                IsEnabled="False"
                                Click="StartProduction_Click">
                            <Grid Margin="14,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Image Width="31" Height="31" Source="/Assets/Icons/ControlPanel/start.png" Stretch="Uniform" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="StartProductionTitleText"
                                               Text="开始运行"
                                               Foreground="White"
                                               FontSize="21"
                                               FontWeight="Bold" />
                                    <TextBlock x:Name="StartProductionHintText"
                                               Text="连续循环 · 放料前DD转两工位并测试"
                                               Foreground="#D7F4E5"
                                               FontSize="11"
                                               Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Grid.Column="2"
                                x:Name="HomeEmergencyStopButton"
                                Style="{StaticResource OperationButton}"
                                Background="#B51623"
                                BorderBrush="#FF626E"
                                IsEnabled="False"
                                Click="HomeEmergencyStop_Click"
                                ToolTip="立即调用运动控制的全轴急停">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="全轴急停"
                                           Foreground="White"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="HomeEmergencyStopHintText"
                                           Text="立即停止所有轴"
                                           Foreground="#FFD8DC"
                                           FontSize="9"
                                           Margin="0,4,0,0"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Button Grid.Row="6"
                            x:Name="MoveAssignedNozzleButton"
                            Style="{StaticResource OperationButton}"
                            Background="#315873"
                            BorderBrush="#527993"
                            IsEnabled="False"
                            Click="MoveAssignedNozzle_Click">
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="35" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Image Width="25" Height="25" Source="/Assets/Icons/ControlPanel/reset.png" Stretch="Uniform" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="MoveAssignedNozzleTitleText"
                                               Text="自动顺序对位"
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="MoveAssignedNozzleHintText"
                                               Text="开始运行后自动执行"
                                               Foreground="#D5E1E9"
                                               FontSize="9"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                    </Button>

                    <Border Grid.Row="7"
                            Margin="0,8,0,8"
                            Padding="9,7"
                            Background="#12283A"
                            BorderBrush="#2D4A61"
                            BorderThickness="1"
                            CornerRadius="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="52" />
                                <RowDefinition Height="52" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <TextBlock Text="第一套 XY 绝对位置（pulse）"
                                           Foreground="#EAF2F7"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="直传绝对脉冲 · 不转换"
                                           Foreground="#49D17D"
                                           FontSize="10"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="116" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="位置 1"
                                           Foreground="#62B5FF"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="X（pulse）" Foreground="#9FB1BF" FontSize="9" TextAlignment="Center" />
                                    <TextBox x:Name="PresetPosition1XTextBox"
                                             Height="25"
                                             Text=""
                                             TextAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Foreground="#10263A"
                                             Background="#F7FAFC"
                                             ToolTip="位置 1 的 X 轴绝对脉冲"
                                             TextChanged="PresetPositionTextBox_TextChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Y（pulse）" Foreground="#9FB1BF" FontSize="9" TextAlignment="Center" />
                                    <TextBox x:Name="PresetPosition1YTextBox"
                                             Height="25"
                                             Text=""
                                             TextAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Foreground="#10263A"
                                             Background="#F7FAFC"
                                             ToolTip="位置 1 的 Y 轴绝对脉冲"
                                             TextChanged="PresetPositionTextBox_TextChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="操作" Foreground="#9FB1BF" FontSize="9" TextAlignment="Center" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="RecordPresetPosition1Button"
                                                Height="25"
                                                Content="记录"
                                                Foreground="White"
                                                Background="#166A52"
                                                BorderBrush="#49D17D"
                                                Cursor="Hand"
                                                IsEnabled="False"
                                                Click="RecordPresetPosition1_Click" />
                                        <Button Grid.Column="2"
                                                x:Name="MovePresetPosition1Button"
                                                Height="25"
                                                Content="移动"
                                                Foreground="White"
                                                Background="#1674D1"
                                                BorderBrush="#62B5FF"
                                                Cursor="Hand"
                                                IsEnabled="False"
                                                Click="MovePresetPosition1_Click" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="116" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="位置 2"
                                           Foreground="#62B5FF"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="X（pulse）" Foreground="#9FB1BF" FontSize="9" TextAlignment="Center" />
                                    <TextBox x:Name="PresetPosition2XTextBox"
                                             Height="25"
                                             Text=""
                                             TextAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Foreground="#10263A"
                                             Background="#F7FAFC"
                                             ToolTip="位置 2 的 X 轴绝对脉冲"
                                             TextChanged="PresetPositionTextBox_TextChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Y（pulse）" Foreground="#9FB1BF" FontSize="9" TextAlignment="Center" />
                                    <TextBox x:Name="PresetPosition2YTextBox"
                                             Height="25"
                                             Text=""
                                             TextAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Foreground="#10263A"
                                             Background="#F7FAFC"
                                             ToolTip="位置 2 的 Y 轴绝对脉冲"
                                             TextChanged="PresetPositionTextBox_TextChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="操作" Foreground="#9FB1BF" FontSize="9" TextAlignment="Center" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="RecordPresetPosition2Button"
                                                Height="25"
                                                Content="记录"
                                                Foreground="White"
                                                Background="#166A52"
                                                BorderBrush="#49D17D"
                                                Cursor="Hand"
                                                IsEnabled="False"
                                                Click="RecordPresetPosition2_Click" />
                                        <Button Grid.Column="2"
                                                x:Name="MovePresetPosition2Button"
                                                Height="25"
                                                Content="移动"
                                                Foreground="White"
                                                Background="#1674D1"
                                                BorderBrush="#62B5FF"
                                                Cursor="Hand"
                                                IsEnabled="False"
                                                Click="MovePresetPosition2_Click" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="3"
                                       x:Name="PresetPositionStatusText"
                                       Text="“记录”读取当前轴1/轴2位置并永久保存；“移动”直传绝对脉冲。"
                                       Foreground="#9FB1BF"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="8"
                            Margin="0,0,0,8"
                            Background="#12283A"
                            BorderBrush="#527993"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="9,7">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="DD马达（轴0）· 固定每转脉冲"
                                       Foreground="#EAF2F7"
                                       FontSize="10"
                                       FontWeight="Bold" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="Axis0PulseTextBox"
                                         Height="25"
                                         Text=""
                                         TextAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Foreground="#10263A"
                                         Background="#F7FAFC"
                                         ToolTip="代码固定：22500 pulse"
                                         TextChanged="Axis0PulseTextBox_TextChanged" />
                                <Button Grid.Column="2"
                                        x:Name="RecordAxis0PulseButton"
                                        Height="25"
                                        Content="固定"
                                        Foreground="White"
                                        Background="#166A52"
                                        BorderBrush="#49D17D"
                                        Cursor="Hand"
                                        IsEnabled="False"
                                        Click="RecordAxis0Pulse_Click" />
                                <Button Grid.Column="4"
                                        x:Name="Axis0MoveButton"
                                        Height="25"
                                        Content="转动"
                                        Foreground="White"
                                        Background="#1674D1"
                                        BorderBrush="#62B5FF"
                                        Cursor="Hand"
                                        IsEnabled="False"
                                        Click="Axis0Move_Click" />
                            </Grid>
                            <TextBlock Grid.Row="2"
                                       x:Name="Axis0MoveStatusText"
                                       Text="代码固定 22500 pulse；按钮按固定脉冲转动一次"
                                       Foreground="#9FB1BF"
                                       FontSize="9"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="9"
                            Margin="0,0,0,8"
                            Background="#12283A"
                            BorderBrush="#8662C5"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="9,7">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="轴13 / 轴14 / 轴15 · 移出绝对位置"
                                       Foreground="#EAF2F7"
                                       FontSize="10"
                                       FontWeight="Bold" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="Axis13To15PulseTextBox"
                                         Height="25"
                                         Text=""
                                         TextAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Foreground="#10263A"
                                         Background="#F7FAFC"
                                         ToolTip="代码固定：轴13、轴14、轴15 绝对位置 250000 pulse"
                                         TextChanged="Axis13To15PulseTextBox_TextChanged" />
                                <Button Grid.Column="2"
                                        x:Name="Axis13To15MoveButton"
                                        Height="25"
                                        Content="移出"
                                        Foreground="White"
                                        Background="#6950A1"
                                        BorderBrush="#B098E4"
                                        Cursor="Hand"
                                        IsEnabled="False"
                                        Click="Axis13To15Move_Click" />
                            </Grid>
                            <TextBlock Grid.Row="2"
                                       x:Name="Axis13To15MoveStatusText"
                                       Text="代码固定绝对位置 250000 pulse；三个轴同时移出"
                                       Foreground="#BFB2DA"
                                       FontSize="9"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>

                    <Button Grid.Row="10"
                            Style="{StaticResource OperationButton}"
                            Background="{StaticResource DangerRed}"
                            BorderBrush="#FF4E57">
                        <Grid Margin="20,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Image Width="32" Height="32" Source="/Assets/Icons/ControlPanel/stop.png" Stretch="Uniform" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="急停" Foreground="White" FontSize="25" FontWeight="Bold" />
                                <TextBlock Text="立即停止全部设备动作" Foreground="#FFE1E3" FontSize="11" Margin="0,3,0,0" />
                                <Border Height="1" Background="#F1656C" Margin="0,12,0,9" />
                                <TextBlock Text="安全操作请优先使用设备实体急停" Foreground="#FFC7CA" FontSize="10" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
