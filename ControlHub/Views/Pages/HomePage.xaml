<UserControl x:Class="ControlHub.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ControlHub.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1680"
             d:DesignHeight="854"
             Background="#0F2335"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PageBackground" Color="#0F2335" />
        <SolidColorBrush x:Key="PanelBackground" Color="#162E43" />
        <SolidColorBrush x:Key="PanelBackgroundAlt" Color="#1A344A" />
        <SolidColorBrush x:Key="PanelBorder" Color="#345269" />
        <SolidColorBrush x:Key="PrimaryBlue" Color="#1674D1" />
        <SolidColorBrush x:Key="PrimaryBlueLight" Color="#62B5FF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F2F6F9" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9FB1BF" />
        <SolidColorBrush x:Key="SuccessGreen" Color="#36C46A" />
        <SolidColorBrush x:Key="WarningAmber" Color="#E7A32B" />
        <SolidColorBrush x:Key="DangerRed" Color="#DB1721" />

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MutedLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TableText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D9E3EA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="StationToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="82" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsChecked" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="SwitchBorder"
                                Background="#45596A"
                                BorderBrush="#617587"
                                BorderThickness="1"
                                CornerRadius="14">
                            <Grid Margin="3,0">
                                <Ellipse x:Name="SwitchThumb"
                                         Width="20"
                                         Height="20"
                                         Fill="#EDF3F7"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="OffLabel"
                                           Text="停用"
                                           Margin="26,0,2,0"
                                           Foreground="#DFE7EC"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="OnLabel"
                                           Text="启用"
                                           Margin="2,0,26,0"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="{StaticResource PrimaryBlue}" />
                                <Setter TargetName="SwitchBorder" Property="BorderBrush" Value="#65B4FA" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="OffLabel" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="OnLabel" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OperationButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.90" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="White" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConditionRow" TargetType="Border">
            <Setter Property="Height" Value="32" />
            <Setter Property="BorderBrush" Value="#2C485E" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style x:Key="StationInstrumentCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Foreground" Value="#E9F1F6" />
            <Setter Property="Background" Value="#193B55" />
            <Setter Property="BorderBrush" Value="#3D6684" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <Style x:Key="CarouselStationCard" TargetType="Border">
            <Setter Property="Width" Value="78" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Background" Value="#153B35" />
            <Setter Property="BorderBrush" Value="#36C46A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,5" />
        </Style>

        <Style x:Key="CarouselStationNumber" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAFBF0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CarouselStationResult" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#36C46A" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CarouselStationObject" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9FB1BF" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="AlarmRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="#2D4A61" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="#162E43" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8" Background="{StaticResource PageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" Height="30" Background="{StaticResource PrimaryBlue}" CornerRadius="2" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock Text="生产运行总览" Style="{StaticResource SectionTitle}" FontSize="18" />
                        <TextBlock x:Name="ProductionModeSummaryText" Text="两站测试 · 自动摆盘" Style="{StaticResource MutedLabel}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="运行模式" Style="{StaticResource MutedLabel}" />
                    <TextBlock Text="自动模式" Foreground="{StaticResource PrimaryBlueLight}" FontSize="14" FontWeight="Bold" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="当前批次" Style="{StaticResource MutedLabel}" />
                    <TextBlock Text="LOT-20260715-A" Foreground="{StaticResource TextPrimary}" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="UPH" Style="{StaticResource MutedLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock x:Name="UphValueText"
                                   Text="0"
                                   Foreground="{StaticResource PrimaryBlueLight}"
                                   FontFamily="Consolas"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   ToolTip="从首次取料开始统计" />
                        <TextBlock Text=" 件/小时"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   VerticalAlignment="Bottom"
                                   Margin="3,0,0,1" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="整机状态" Style="{StaticResource MutedLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessGreen}" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="设备就绪" Foreground="{StaticResource SuccessGreen}" FontSize="14" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="336" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="176" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="0" />
                    <RowDefinition Height="0" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="测试站概览" Style="{StaticResource SectionTitle}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="EnabledStationSummaryIndicator" Width="7" Height="7" Fill="{StaticResource SuccessGreen}" Margin="0,0,6,0" />
                        <TextBlock x:Name="EnabledStationSummaryText" Text="2 / 3 站已启用" Foreground="{StaticResource SuccessGreen}" FontSize="12" FontWeight="Bold" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="Station1Card" Grid.Column="0" Style="{StaticResource Panel}" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="48" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" Background="#214B70" BorderBrush="#3D78A6" BorderThickness="1" CornerRadius="3" Margin="0,0,9,0">
                                        <TextBlock Text="01" Foreground="{StaticResource PrimaryBlueLight}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="测试站 01" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold" />
                                        <TextBlock Text="5号工位 · 轴13" Style="{StaticResource MutedLabel}" FontSize="11" Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <ToggleButton x:Name="Station1EnabledToggle" Grid.Column="1" Style="{StaticResource StationToggle}" Click="TestStationEnabledToggle_Click" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="当前状态" Style="{StaticResource MutedLabel}" />
                                <TextBlock x:Name="Station1StatusText" Grid.Column="1" Text="等待来料" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="#153B35" BorderBrush="#28725C" BorderThickness="1" CornerRadius="3" Padding="9,3" VerticalAlignment="Center">
                                    <TextBlock x:Name="Station1StateBadgeText" Text="待机" Foreground="{StaticResource SuccessGreen}" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </Grid>
                            <Border Grid.Row="2" Background="#12283A" BorderBrush="#29465C" BorderThickness="1" CornerRadius="3" Padding="10,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="26" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="分配仪表" Style="{StaticResource MutedLabel}" />
                                    <ComboBox x:Name="Station1InstrumentComboBox" Grid.Column="1" Height="24" Style="{StaticResource StationInstrumentCombo}" SelectionChanged="TestStationInstrumentComboBox_SelectionChanged">
                                        <ComboBoxItem Content="未分配" />
                                        <ComboBoxItem Content="E4981A（TCP）" />
                                        <ComboBoxItem Content="SM7110（串口）" />
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Text="测试数据" Style="{StaticResource MutedLabel}" />
                                    <TextBlock x:Name="Station1ResultText" Grid.Row="1" Grid.Column="1" Text="暂无结果" Foreground="#9FB1BF" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="Station2Card" Grid.Column="2" Style="{StaticResource Panel}" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="48" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" Background="#214B70" BorderBrush="#3D78A6" BorderThickness="1" CornerRadius="3" Margin="0,0,9,0">
                                        <TextBlock Text="02" Foreground="{StaticResource PrimaryBlueLight}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="测试站 02" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold" />
                                        <TextBlock Text="6号工位 · 轴14" Style="{StaticResource MutedLabel}" FontSize="11" Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <ToggleButton x:Name="Station2EnabledToggle" Grid.Column="1" Style="{StaticResource StationToggle}" Click="TestStationEnabledToggle_Click" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="当前状态" Style="{StaticResource MutedLabel}" />
                                <TextBlock x:Name="Station2StatusText" Grid.Column="1" Text="等待来料" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="#173852" BorderBrush="#316C95" BorderThickness="1" CornerRadius="3" Padding="9,3" VerticalAlignment="Center">
                                    <TextBlock x:Name="Station2StateBadgeText" Text="待机" Foreground="{StaticResource SuccessGreen}" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </Grid>
                            <Border Grid.Row="2" Background="#12283A" BorderBrush="#29465C" BorderThickness="1" CornerRadius="3" Padding="10,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="26" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="分配仪表" Style="{StaticResource MutedLabel}" />
                                    <ComboBox x:Name="Station2InstrumentComboBox" Grid.Column="1" Height="24" Style="{StaticResource StationInstrumentCombo}" SelectionChanged="TestStationInstrumentComboBox_SelectionChanged">
                                        <ComboBoxItem Content="未分配" />
                                        <ComboBoxItem Content="E4981A（TCP）" />
                                        <ComboBoxItem Content="SM7110（串口）" />
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Text="测试数据" Style="{StaticResource MutedLabel}" />
                                    <TextBlock x:Name="Station2ResultText" Grid.Row="1" Grid.Column="1" Text="暂无结果" Foreground="#9FB1BF" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="Station3Card" Grid.Column="4" Style="{StaticResource Panel}" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="48" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" Background="#214B70" BorderBrush="#3D78A6" BorderThickness="1" CornerRadius="3" Margin="0,0,9,0">
                                        <TextBlock Text="03" Foreground="{StaticResource PrimaryBlueLight}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="测试站 03" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold" />
                                        <TextBlock Text="7号工位 · 轴15" Style="{StaticResource MutedLabel}" FontSize="11" Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <ToggleButton x:Name="Station3EnabledToggle" Grid.Column="1" Style="{StaticResource StationToggle}" Click="TestStationEnabledToggle_Click" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="当前状态" Style="{StaticResource MutedLabel}" />
                                <TextBlock x:Name="Station3StatusText" Grid.Column="1" Text="已关闭" Foreground="{StaticResource TextSecondary}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="#393322" BorderBrush="#78652F" BorderThickness="1" CornerRadius="3" Padding="9,3" VerticalAlignment="Center">
                                    <TextBlock x:Name="Station3StateBadgeText" Text="停用" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </Grid>
                            <Border Grid.Row="2" Background="#12283A" BorderBrush="#29465C" BorderThickness="1" CornerRadius="3" Padding="10,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="26" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="分配仪表" Style="{StaticResource MutedLabel}" />
                                    <ComboBox x:Name="Station3InstrumentComboBox" Grid.Column="1" Height="24" Style="{StaticResource StationInstrumentCombo}" SelectionChanged="TestStationInstrumentComboBox_SelectionChanged">
                                        <ComboBoxItem Content="未分配" />
                                        <ComboBoxItem Content="E4981A（TCP）" />
                                        <ComboBoxItem Content="SM7110（串口）" />
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Text="测试数据" Style="{StaticResource MutedLabel}" />
                                    <TextBlock x:Name="Station3ResultText" Grid.Row="1" Grid.Column="1" Text="暂无结果" Foreground="#9FB1BF" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 本次海康拍照及 Blob 分析结果显示区。 -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="4" Height="20" Background="#49D17D" CornerRadius="2" Margin="0,0,9,0" />
                                <TextBlock Text="海康 Blob 检测画面"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="#173852"
                                    BorderBrush="#316C95"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="9,3"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="BlobInspectionImageStatusText"
                                           Text="等待检测"
                                           Foreground="{StaticResource PrimaryBlueLight}"
                                           FontSize="10"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="#07131D"
                                BorderBrush="#29465C"
                                BorderThickness="1"
                                CornerRadius="3"
                                ClipToBounds="True">
                            <Grid>
                                <controls:VisionMasterDisplayHost x:Name="BlobInspectionVisionDisplayHost"
                                                                  Visibility="Hidden"
                                                                  HostSizeChanged="BlobInspectionVisionDisplayHost_HostSizeChanged" />

                                <Viewbox x:Name="BlobInspectionImageViewbox"
                                         Stretch="Uniform"
                                         StretchDirection="Both"
                                         Visibility="Collapsed"
                                         SnapsToDevicePixels="True"
                                         RenderOptions.BitmapScalingMode="NearestNeighbor">
                                    <Grid x:Name="BlobInspectionImageSurface"
                                          Width="1"
                                          Height="1"
                                          Background="Black"
                                          SnapsToDevicePixels="True"
                                          RenderOptions.BitmapScalingMode="NearestNeighbor">
                                        <Image x:Name="BlobInspectionImage"
                                               Stretch="Fill"
                                               SnapsToDevicePixels="True"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        <Canvas x:Name="BlobInspectionOverlayCanvas"
                                                Width="1"
                                                Height="1"
                                                IsHitTestVisible="False" />
