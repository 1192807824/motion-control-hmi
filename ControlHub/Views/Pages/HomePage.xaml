<UserControl x:Class="ControlHub.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ControlHub.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1680"
             d:DesignHeight="854"
             Background="#0F2335"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PageBackground" Color="#0F2335" />
        <SolidColorBrush x:Key="PanelBackground" Color="#162E43" />
        <SolidColorBrush x:Key="PanelBackgroundAlt" Color="#1A344A" />
        <SolidColorBrush x:Key="PanelBorder" Color="#345269" />
        <SolidColorBrush x:Key="PrimaryBlue" Color="#1674D1" />
        <SolidColorBrush x:Key="PrimaryBlueLight" Color="#62B5FF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F2F6F9" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9FB1BF" />
        <SolidColorBrush x:Key="SuccessGreen" Color="#36C46A" />
        <SolidColorBrush x:Key="WarningAmber" Color="#E7A32B" />
        <SolidColorBrush x:Key="DangerRed" Color="#DB1721" />

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MutedLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TableText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D9E3EA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="StationToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="82" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsChecked" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="SwitchBorder"
                                Background="#45596A"
                                BorderBrush="#617587"
                                BorderThickness="1"
                                CornerRadius="14">
                            <Grid Margin="3,0">
                                <Ellipse x:Name="SwitchThumb"
                                         Width="20"
                                         Height="20"
                                         Fill="#EDF3F7"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="OffLabel"
                                           Text="停用"
                                           Margin="26,0,2,0"
                                           Foreground="#DFE7EC"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="OnLabel"
                                           Text="启用"
                                           Margin="2,0,26,0"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="{StaticResource PrimaryBlue}" />
                                <Setter TargetName="SwitchBorder" Property="BorderBrush" Value="#65B4FA" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="OffLabel" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="OnLabel" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OperationButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.90" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="White" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConditionRow" TargetType="Border">
            <Setter Property="Height" Value="32" />
            <Setter Property="BorderBrush" Value="#2C485E" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style x:Key="CarouselStationCard" TargetType="Border">
            <Setter Property="Width" Value="78" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Background" Value="#153B35" />
            <Setter Property="BorderBrush" Value="#36C46A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,5" />
        </Style>

        <Style x:Key="CarouselStationNumber" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAFBF0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CarouselStationResult" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#36C46A" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CarouselStationObject" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9FB1BF" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="AlarmRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="#2D4A61" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="#162E43" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8" Background="{StaticResource PageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" Height="30" Background="{StaticResource PrimaryBlue}" CornerRadius="2" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock Text="生产运行总览" Style="{StaticResource SectionTitle}" FontSize="18" />
                        <TextBlock Text="三站测试 · 自动摆盘" Style="{StaticResource MutedLabel}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="运行模式" Style="{StaticResource MutedLabel}" />
                    <TextBlock Text="自动模式" Foreground="{StaticResource PrimaryBlueLight}" FontSize="14" FontWeight="Bold" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="当前批次" Style="{StaticResource MutedLabel}" />
                    <TextBlock Text="LOT-20260715-A" Foreground="{StaticResource TextPrimary}" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="整机状态" Style="{StaticResource MutedLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessGreen}" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="设备就绪" Foreground="{StaticResource SuccessGreen}" FontSize="14" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="336" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="176" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="0" />
                    <RowDefinition Height="0" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="测试站概览" Style="{StaticResource SectionTitle}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessGreen}" Margin="0,0,6,0" />
                        <TextBlock Text="3 / 3 站已启用" Foreground="{StaticResource SuccessGreen}" FontSize="12" FontWeight="Bold" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="48" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" Background="#214B70" BorderBrush="#3D78A6" BorderThickness="1" CornerRadius="3" Margin="0,0,9,0">
                                        <TextBlock Text="01" Foreground="{StaticResource PrimaryBlueLight}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="测试站 01" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold" />
                                        <TextBlock Text="外观与尺寸" Style="{StaticResource MutedLabel}" FontSize="11" Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource StationToggle}" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="当前状态" Style="{StaticResource MutedLabel}" />
                                <TextBlock Grid.Column="1" Text="等待来料" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="#153B35" BorderBrush="#28725C" BorderThickness="1" CornerRadius="3" Padding="9,3" VerticalAlignment="Center">
                                    <TextBlock Text="待机" Foreground="{StaticResource SuccessGreen}" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </Grid>
                            <Border Grid.Row="2" Background="#12283A" BorderBrush="#29465C" BorderThickness="1" CornerRadius="3" Padding="10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="当前产品" Style="{StaticResource MutedLabel}" />
                                    <TextBlock Grid.Column="1" Text="—" Foreground="#D6E0E7" FontFamily="Consolas" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="无报警" Foreground="#8FB5A2" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="48" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" Background="#214B70" BorderBrush="#3D78A6" BorderThickness="1" CornerRadius="3" Margin="0,0,9,0">
                                        <TextBlock Text="02" Foreground="{StaticResource PrimaryBlueLight}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="测试站 02" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold" />
                                        <TextBlock Text="电性能测试" Style="{StaticResource MutedLabel}" FontSize="11" Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource StationToggle}" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="当前状态" Style="{StaticResource MutedLabel}" />
                                <TextBlock Grid.Column="1" Text="参数采集中" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="#173852" BorderBrush="#316C95" BorderThickness="1" CornerRadius="3" Padding="9,3" VerticalAlignment="Center">
                                    <TextBlock Text="运行中" Foreground="{StaticResource PrimaryBlueLight}" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </Grid>
                            <Border Grid.Row="2" Background="#12283A" BorderBrush="#29465C" BorderThickness="1" CornerRadius="3" Padding="10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="当前产品" Style="{StaticResource MutedLabel}" />
                                    <TextBlock Grid.Column="1" Text="SN-0000728" Foreground="#D6E0E7" FontFamily="Consolas" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="无报警" Foreground="#8FB5A2" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource Panel}" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="48" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" Background="#214B70" BorderBrush="#3D78A6" BorderThickness="1" CornerRadius="3" Margin="0,0,9,0">
                                        <TextBlock Text="03" Foreground="{StaticResource PrimaryBlueLight}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="测试站 03" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold" />
                                        <TextBlock Text="复检与分选" Style="{StaticResource MutedLabel}" FontSize="11" Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource StationToggle}" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="当前状态" Style="{StaticResource MutedLabel}" />
                                <TextBlock Grid.Column="1" Text="等待上游" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="#393322" BorderBrush="#78652F" BorderThickness="1" CornerRadius="3" Padding="9,3" VerticalAlignment="Center">
                                    <TextBlock Text="等待" Foreground="{StaticResource WarningAmber}" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </Grid>
                            <Border Grid.Row="2" Background="#12283A" BorderBrush="#29465C" BorderThickness="1" CornerRadius="3" Padding="10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="当前产品" Style="{StaticResource MutedLabel}" />
                                    <TextBlock Grid.Column="1" Text="—" Foreground="#D6E0E7" FontFamily="Consolas" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="无报警" Foreground="#8FB5A2" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 本次海康拍照及 Blob 分析结果显示区。 -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="4" Height="20" Background="#49D17D" CornerRadius="2" Margin="0,0,9,0" />
                                <TextBlock Text="海康 Blob 检测画面"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="#173852"
                                    BorderBrush="#316C95"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="9,3"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="BlobInspectionImageStatusText"
                                           Text="等待检测"
                                           Foreground="{StaticResource PrimaryBlueLight}"
                                           FontSize="10"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="#07131D"
                                BorderBrush="#29465C"
                                BorderThickness="1"
                                CornerRadius="3"
                                ClipToBounds="True">
                            <Grid>
                                <controls:VisionMasterDisplayHost x:Name="BlobInspectionVisionDisplayHost"
                                                                  Visibility="Hidden"
                                                                  HostSizeChanged="BlobInspectionVisionDisplayHost_HostSizeChanged" />

                                <Viewbox x:Name="BlobInspectionImageViewbox"
                                         Stretch="Uniform"
                                         StretchDirection="Both"
                                         Visibility="Collapsed"
                                         SnapsToDevicePixels="True"
                                         RenderOptions.BitmapScalingMode="NearestNeighbor">
                                    <Grid x:Name="BlobInspectionImageSurface"
                                          Width="1"
                                          Height="1"
                                          Background="Black"
                                          SnapsToDevicePixels="True"
                                          RenderOptions.BitmapScalingMode="NearestNeighbor">
                                        <Image x:Name="BlobInspectionImage"
                                               Stretch="Fill"
                                               SnapsToDevicePixels="True"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        <Canvas x:Name="BlobInspectionOverlayCanvas"
                                                Width="1"
                                                Height="1"
                                                IsHitTestVisible="False" />
                                    </Grid>
                                </Viewbox>

                                <StackPanel x:Name="BlobInspectionImagePlaceholder"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="◫"
                                               Foreground="#42657E"
                                               FontSize="32"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="等待海康相机拍照"
                                               Foreground="#8FA6B7"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Margin="0,5,0,0"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Blob分析完成后在此显示矩形框与质心"
                                               Foreground="#607D91"
                                               FontSize="10"
                                               Margin="0,4,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                    <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="4" Height="20" Background="{StaticResource SuccessGreen}" CornerRadius="2" Margin="0,0,9,0" />
                                    <TextBlock Text="16工位转盘状态"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessGreen}" Margin="0,0,6,0" />
                                    <TextBlock Text="默认空工位" Foreground="{StaticResource SuccessGreen}" FontSize="11" FontWeight="Bold" />
                                </StackPanel>
                            </Grid>

                            <Viewbox Grid.Row="1"
                                     Stretch="Uniform"
                                     StretchDirection="DownOnly"
                                     Margin="0,4,0,2">
                                <Canvas Width="560" Height="560">
                                    <Ellipse Width="360"
                                             Height="360"
                                             Canvas.Left="100"
                                             Canvas.Top="100"
                                             Fill="#10283A"
                                             Stroke="#29465C"
                                             StrokeThickness="2" />
                                    <Ellipse Width="228"
                                             Height="228"
                                             Canvas.Left="166"
                                             Canvas.Top="166"
                                             Fill="#0C1F2F"
                                             Stroke="#345269"
                                             StrokeThickness="1" />
                                    <StackPanel Width="160"
                                                Height="72"
                                                Canvas.Left="200"
                                                Canvas.Top="244"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="一圈16工位"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center" />
                                        <TextBlock Text="待检测 / 有物体 / 检测完成"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="12"
                                                   Margin="0,8,0,0"
                                                   TextAlignment="Center" />
                                    </StackPanel>

                                    <Border Canvas.Left="241" Canvas.Top="16" Style="{StaticResource CarouselStationCard}">
