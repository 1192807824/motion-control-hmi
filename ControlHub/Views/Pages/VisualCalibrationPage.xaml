<UserControl x:Class="ControlHub.Views.Pages.VisualCalibrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:ControlHub.Views.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1500"
             d:DesignHeight="820">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F8FB" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PanelLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AFC0CD" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="PanelInput" TargetType="TextBox">
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#10263A" />
            <Setter Property="Background" Value="#F7FAFC" />
            <Setter Property="BorderBrush" Value="#668198" />
        </Style>
        <Style x:Key="PanelComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#10263A" />
            <Setter Property="Background" Value="#F7FAFC" />
            <Setter Property="BorderBrush" Value="#668198" />
        </Style>
        <Style x:Key="PanelButton" TargetType="Button">
            <Setter Property="Height" Value="29" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0D6EE8" />
            <Setter Property="BorderBrush" Value="#0B5CC2" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="#10283C" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="JogButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#F4F8FB" />
            <Setter Property="Background" Value="#123B59" />
            <Setter Property="BorderBrush" Value="#2A789E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ManualJogButton_PreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ManualJogButton_PreviewMouseLeftButtonUp" />
            <EventSetter Event="MouseLeave" Handler="ManualJogButton_MouseLeave" />
            <EventSetter Event="LostMouseCapture" Handler="ManualJogButton_LostMouseCapture" />
            <EventSetter Event="PreviewKeyDown" Handler="ManualJogButton_PreviewKeyDown" />
            <EventSetter Event="PreviewKeyUp" Handler="ManualJogButton_PreviewKeyUp" />
            <EventSetter Event="LostKeyboardFocus" Handler="ManualJogButton_LostKeyboardFocus" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#17577D" />
                    <Setter Property="BorderBrush" Value="#38A0D0" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D6EE8" />
                    <Setter Property="BorderBrush" Value="#5EA8FF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.42" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8" Background="#071D2F">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="10,0"
                Background="#071D2F"
                BorderBrush="#345269"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="视觉标定"
                               Foreground="#F4F8FB"
                               FontSize="21"
                               FontWeight="Bold" />
                    <Ellipse x:Name="HostStatusIndicator"
                             Width="12"
                             Height="12"
                             Margin="20,0,0,0"
                             Fill="#E0A21A" />
                    <TextBlock x:Name="HostStatusText"
                               Margin="9,0,0,0"
                               MaxWidth="150"
                               Text="正在准备视觉组件…"
                               Foreground="#D8E4EC"
                               FontSize="14"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Text="标定类型"
                               Foreground="#AFC0CD"
                               FontSize="12"
                               Margin="18,0,8,0"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="AxisSetComboBox"
                              Width="168"
                              Height="34"
                              VerticalContentAlignment="Center"
                              SelectionChanged="AxisSet_SelectionChanged">
                        <ComboBoxItem Content="第一套 XY 标定" Tag="First" />
                        <ComboBoxItem Content="下相机标定" Tag="LowerCamera" />
                    </ComboBox>
                    <TextBlock x:Name="LowerCameraNozzleLabel"
                               Text="吸嘴"
                               Foreground="#AFC0CD"
                               FontSize="12"
                               Margin="14,0,8,0"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                    <ComboBox x:Name="LowerCameraNozzleComboBox"
                              Width="92"
                              Height="34"
                              VerticalContentAlignment="Center"
                              ToolTip="下相机的吸嘴1、吸嘴2都使用第一套 XY（轴1/2），每次只标一个吸嘴"
                              Visibility="Collapsed"
                              SelectionChanged="LowerCameraNozzle_SelectionChanged">
                        <ComboBoxItem Content="吸嘴 1" Tag="1" />
                        <ComboBoxItem Content="吸嘴 2" Tag="2" />
                    </ComboBox>
                    <StackPanel x:Name="LowerCameraArrivalPanel"
                                Margin="10,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="1:X"
                                   Foreground="#AFC0CD"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="ArrivalPosition1XTextBox"
                                 Width="62"
                                 Height="30"
                                 Margin="4,0,5,0"
                                 Style="{StaticResource PanelInput}"
                                 ToolTip="到位1的X轴绝对脉冲坐标"
                                 TextChanged="ArrivalPosition_Changed" />
                        <TextBlock Text="Y"
                                   Foreground="#AFC0CD"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="ArrivalPosition1YTextBox"
                                 Width="62"
                                 Height="30"
                                 Margin="4,0,5,0"
                                 Style="{StaticResource PanelInput}"
                                 ToolTip="到位1的Y轴绝对脉冲坐标"
                                 TextChanged="ArrivalPosition_Changed" />
                        <Button x:Name="MoveToArrivalPosition1Button"
                                Width="62"
                                Height="34"
                                Content="到位1"
                                Style="{StaticResource PanelButton}"
                                Click="MoveToArrivalPosition1_Click"
                                ToolTip="按速度100000移动第一套XY（轴1/2）到到位1坐标" />
                        <TextBlock Text="2:X"
                                   Margin="9,0,0,0"
                                   Foreground="#AFC0CD"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="ArrivalPosition2XTextBox"
                                 Width="62"
                                 Height="30"
                                 Margin="4,0,5,0"
                                 Style="{StaticResource PanelInput}"
                                 ToolTip="到位2的X轴绝对脉冲坐标"
                                 TextChanged="ArrivalPosition_Changed" />
                        <TextBlock Text="Y"
                                   Foreground="#AFC0CD"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="ArrivalPosition2YTextBox"
                                 Width="62"
                                 Height="30"
                                 Margin="4,0,5,0"
                                 Style="{StaticResource PanelInput}"
                                 ToolTip="到位2的Y轴绝对脉冲坐标"
                                 TextChanged="ArrivalPosition_Changed" />
                        <Button x:Name="MoveToArrivalPosition2Button"
                                Width="62"
                                Height="34"
                                Content="到位2"
                                Style="{StaticResource PanelButton}"
                                Click="MoveToArrivalPosition2_Click"
                                ToolTip="按速度100000移动第一套XY（轴1/2）到到位2坐标" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Margin="10,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="CalibrationEmergencyStopButton"
                            Content="全轴急停"
                            Height="38"
                            Padding="14,0"
                            Margin="0,0,8,0"
                            Foreground="White"
                            Background="#C9363E"
                            BorderBrush="#E45A61"
                            FontWeight="Bold"
                            Cursor="Hand"
                            IsEnabled="False"
                            Click="CalibrationEmergencyStop_Click"
                            ToolTip="立即调用运动控制的全轴急停" />
                    <Button x:Name="RestartHostButton"
                            Content="重启视觉"
                            Height="38"
                            Padding="14,0"
                            Margin="0,0,8,0"
                            Foreground="White"
                            Background="#0B2235"
                            BorderBrush="#45647A"
                            Cursor="Hand"
                            IsEnabled="False"
                            Click="RestartHost_Click" />
                    <Button x:Name="CloseVisionButton"
                            Content="关闭视觉"
                            Height="38"
                            Padding="14,0"
                            Foreground="White"
                            Background="#6E252A"
                            BorderBrush="#B84B52"
                            Cursor="Hand"
                            Click="CloseVision_Click"
                            ToolTip="关闭 VisionMasterHost 和所有 VisionMaster 相关进程，释放相机及视觉资源" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="156" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Visibility="Collapsed"
                    Padding="10"
                    Background="#163047"
                    BorderBrush="#345269"
                    BorderThickness="1"
                    CornerRadius="5">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCard}">
                            <Button x:Name="StartLivePreviewButton"
                                    Content="获取实时画面"
                                    Style="{StaticResource PanelButton}"
                                    Click="StartLivePreview_Click" />
                        </Border>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="第一套 XY 标定"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold" />
                            <TextBlock Grid.Column="1"
                                       Text="轴1=X　轴2=Y"
                                       Foreground="#8FB2C9"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock x:Name="CenterSectionTitleText"
                                           Text="1　移动中心"
                                           Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="轴1 X（pulse）" Style="{StaticResource PanelLabel}" />
                                        <Border Height="27" Background="#243E52" CornerRadius="2">
                                            <TextBlock x:Name="CenterXPulseText"
                                                       Text="未配置"
                                                       Foreground="#F4F8FB"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="轴2 Y（pulse）" Style="{StaticResource PanelLabel}" />
                                        <Border Height="27" Background="#243E52" CornerRadius="2">
                                            <TextBlock x:Name="CenterYPulseText"
                                                       Text="未配置"
                                                       Foreground="#F4F8FB"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="CenterVmText"
                                           Margin="0,4"
                                           Text="基准点 X：--　Y：--"
                                           Foreground="#49D17D"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center" />
                                <Button x:Name="RecordCenterButton"
                                        Content="移动中心"
                                        Style="{StaticResource PanelButton}"
                                        Click="MoveTeachingCenter_Click" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="2　九点参数" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="间距 X（pulse）" Style="{StaticResource PanelLabel}" />
                                        <TextBox x:Name="StepXPulsesTextBox"
                                                 Text="100000"
                                                 Style="{StaticResource PanelInput}"
                                                 TextChanged="CalibrationInput_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="间距 Y（pulse）" Style="{StaticResource PanelLabel}" />
                                        <TextBox x:Name="StepYPulsesTextBox"
                                                 Text="100000"
                                                 Style="{StaticResource PanelInput}"
                                                 TextChanged="CalibrationInput_Changed" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="OffsetVmText"
                                           Margin="0,3,0,4"
                                           Text="VisionMaster：X 10　Y 10"
                                           Foreground="#49D17D"
                                           FontSize="11"
                                           TextAlignment="Center" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="移动顺序" Style="{StaticResource PanelLabel}" />
                                        <ComboBox x:Name="MovePriorityComboBox"
                                                  Style="{StaticResource PanelComboBox}"
                                                  SelectedIndex="0"
                                                  SelectionChanged="MovePriority_SelectionChanged">
                                            <ComboBoxItem Content="X优先" Tag="X" />
                                            <ComboBoxItem Content="Y优先" Tag="Y" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="速度（pulse/s）" Style="{StaticResource PanelLabel}" />
                                        <TextBox x:Name="VelocityTextBox"
                                                 Text="100000"
                                                 Style="{StaticResource PanelInput}"
                                                 TextChanged="CalibrationSetting_Changed" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="到位等待（ms）"
                                               Style="{StaticResource PanelLabel}"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2"
                                             x:Name="SettleMillisecondsTextBox"
                                             Text="300"
                                             Style="{StaticResource PanelInput}"
                                             TextChanged="CalibrationSetting_Changed" />
                                </Grid>
                                <ProgressBar x:Name="CalibrationProgressBar"
                                             Margin="0,6,0,0"
                                             Height="5"
                                             Minimum="0"
                                             Maximum="9"
                                             Value="0" />
                                <TextBlock x:Name="WorkflowStatusText"
                                           Margin="0,4,0,4"
                                           MinHeight="20"
                                           MaxHeight="30"
                                           Text="请先在参数配置中设置中心位，然后点击移动中心"
                                           Foreground="#D8E4EC"
                                           FontSize="11"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="68" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="StartCalibrationButton"
                                            Content="一键九点标定"
                                            Style="{StaticResource PanelButton}"
                                            Background="#17834A"
                                            BorderBrush="#12683A"
                                            IsEnabled="False"
                                            Click="StartCalibration_Click" />
                                    <Button Grid.Column="2"
                                            x:Name="StopCalibrationButton"
                                            Content="停止"
                                            Style="{StaticResource PanelButton}"
                                            Background="#D90D16"
                                            BorderBrush="#A90A12"
                                            IsEnabled="False"
                                            Click="StopCalibration_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="3　粗定位示教"
                                               Style="{StaticResource SectionTitle}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               x:Name="NozzleTeachStepText"
                                               Text="等待手动打点"
                                               Foreground="#49D17D"
                                               FontSize="10"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="RecordNozzleDotPositionButton"
                                            Content="移动下压位置"
                                            Style="{StaticResource PanelButton}"
                                            Background="#294A64"
                                            BorderBrush="#45647A"
                                            FontSize="11"
                                            Click="MoveTeachingPressPosition_Click" />
                                    <Button Grid.Column="2"
                                            x:Name="ReturnToPhotoPositionButton"
                                            Content="回拍照位"
                                            Style="{StaticResource PanelButton}"
                                            Background="#0B4CA3"
                                            BorderBrush="#0D6EE8"
                                            FontSize="11"
                                            Click="ReturnCameraToCenter_Click" />
                                </Grid>
                                <Button x:Name="FindNozzlePointsButton"
                                        Margin="0,5,0,0"
                                        Content="执行粗定位示教"
                                        Style="{StaticResource PanelButton}"
                                        Background="#294A64"
                                        BorderBrush="#45647A"
                                        FontSize="11"
                                        Click="FindNozzlePoints_Click" />
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="AssignPoint1ToNozzle1Button"
                                            Grid.ColumnSpan="3"
                                            Content="保存双吸嘴结果"
                                            Style="{StaticResource PanelButton}"
                                            Background="#294A64"
                                            BorderBrush="#45647A"
                                            FontSize="11"
                                            IsEnabled="False"
                                            Click="AssignPoint1ToNozzle1_Click" />
                                    <Button Grid.Column="2"
                                            x:Name="AssignPoint1ToNozzle2Button"
                                            Content="点1 = 吸嘴2"
                                            Style="{StaticResource PanelButton}"
                                            Background="#294A64"
                                            BorderBrush="#45647A"
                                            FontSize="11"
                                            IsEnabled="False"
                                            Visibility="Collapsed"
                                            Click="AssignPoint1ToNozzle2_Click" />
                                </Grid>
                                <TextBlock x:Name="NozzleCalibrationStatusText"
                                           Margin="0,4,0,0"
                                           MinHeight="30"
                                           Text="从参数配置读取示教下压位，移动后让两个吸嘴同时打点"
                                           Foreground="#8FB2C9"
                                           FontSize="10"
                                           LineHeight="16"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="ClickMoveSection"
                                Style="{StaticResource SectionCard}"
                                Margin="0">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="4　点击移动"
                                               Style="{StaticResource SectionTitle}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="2"
                                              x:Name="ClickTargetToolComboBox"
                                              Style="{StaticResource PanelComboBox}"
                                              SelectionChanged="ClickTargetTool_SelectionChanged">
                                        <ComboBoxItem Content="相机中心对准" Tag="Camera" />
                                        <ComboBoxItem Content="吸嘴1中心对准" Tag="Nozzle1" />
                                        <ComboBoxItem Content="吸嘴2中心对准" Tag="Nozzle2" />
                                    </ComboBox>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="78" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="EnableClickMoveCheckBox"
                                              Foreground="#F4F8FB"
                                              FontWeight="SemiBold"
                                              Content="点击图像移动"
                                              VerticalAlignment="Center"
                                              Checked="EnableClickMove_Changed"
                                              Unchecked="EnableClickMove_Changed" />
                                    <Button Grid.Column="1"
                                            x:Name="StopClickMoveButton"
                                            Content="停止移动"
                                            Style="{StaticResource PanelButton}"
                                            Background="#D90D16"
                                            BorderBrush="#A90A12"
                                            IsEnabled="False"
                                            Click="StopClickMove_Click" />
                                </Grid>
                                <TextBlock x:Name="ClickMoveStatusText"
                                           Margin="0,4,0,0"
                                           MaxHeight="24"
                                           Text="未启用"
                                           Foreground="#8FB2C9"
                                           FontSize="10"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Grid.Row="0"
                    Background="#202427"
                    BorderBrush="#345269"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True">
                <Grid>
                    <controls:VisionMasterProcessHost x:Name="VisionHost"
                                                      Started="VisionHost_Started"
                                                      Failed="VisionHost_Failed"
                                                      Exited="VisionHost_Exited"
                                                      CalibrationToolbarActionRequested="VisionHost_CalibrationToolbarActionRequested"
                                                      CalibrationSidebarActionRequested="VisionHost_CalibrationSidebarActionRequested"
                                                      ClickTargetReceived="VisionHost_ClickTargetReceived"
                                                      ClickTargetFailed="VisionHost_ClickTargetFailed" />
                    <StackPanel x:Name="HostPlaceholder"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock Text="视觉组件启动中…"
                                   Foreground="#AAB9C6"
                                   FontSize="14"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="2"
                    Margin="0,8,0,0"
                    Padding="10,8"
                    Background="#0B263A"
                    BorderBrush="#294F68"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid x:Name="ManualJogPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="196" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="158" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="124" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="124" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="2,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="第一套手动点动"
                                   Foreground="#F4F8FB"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,3,0,7"
                                   Text="XY 固定使用轴1/2；Z/R 按吸嘴切换"
                                   Foreground="#8FB2C9"
                                   FontSize="11" />
                        <ComboBox x:Name="ManualJogNozzleComboBox"
                                  Width="116"
                                  HorizontalAlignment="Left"
                                  Style="{StaticResource PanelComboBox}"
                                  SelectionChanged="ManualJogSetting_Changed">
                            <ComboBoxItem Content="吸嘴 1" Tag="1" />
                            <ComboBoxItem Content="吸嘴 2" Tag="2" />
                        </ComboBox>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#294F68" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="XY 平移·按住运行"
                                   Style="{StaticResource PanelLabel}"
                                   Margin="0,0,0,1" />
                        <Grid Width="114" Height="96" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Tag="Y:1" Content="↑"
                                    Width="35" Height="30" FontSize="19"
                                    Style="{StaticResource JogButton}" ToolTip="Y 正向（轴2）" />
                            <Button Grid.Row="1" Grid.Column="0" Tag="X:-1" Content="←"
                                    Width="35" Height="30" FontSize="19"
                                    Style="{StaticResource JogButton}" ToolTip="X 负向（轴1）" />
                            <Border Grid.Row="1" Grid.Column="1" Width="32" Height="28"
                                    Margin="3" Background="#071D2F" BorderBrush="#294F68"
                                    BorderThickness="1" CornerRadius="3">
                                <TextBlock Text="XY" Foreground="#8FB2C9" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button Grid.Row="1" Grid.Column="2" Tag="X:1" Content="→"
                                    Width="35" Height="30" FontSize="19"
                                    Style="{StaticResource JogButton}" ToolTip="X 正向（轴1）" />
                            <Button Grid.Row="2" Grid.Column="1" Tag="Y:-1" Content="↓"
                                    Width="35" Height="30" FontSize="19"
                                    Style="{StaticResource JogButton}" ToolTip="Y 负向（轴2）" />
                        </Grid>
                    </StackPanel>

                    <Border Grid.Column="3" Background="#294F68" />

                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="Z 升降"
                                   Style="{StaticResource PanelLabel}"
                                   Margin="0,0,0,5" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Tag="Z:-1" Content="↥"
                                    Style="{StaticResource JogButton}" ToolTip="Z 上升（负向）" />
                            <Button Tag="Z:1" Content="↧"
                                    Style="{StaticResource JogButton}" ToolTip="Z 下降（正向）" />
                        </StackPanel>
                        <TextBlock Text="上升　下降" Foreground="#8FB2C9" FontSize="10"
                                   Margin="0,4,0,0" TextAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Column="5" Background="#294F68" />

                    <StackPanel Grid.Column="6" VerticalAlignment="Center">
                        <TextBlock Text="R 旋转"
                                   Style="{StaticResource PanelLabel}"
                                   Margin="0,0,0,5" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Tag="R:-1" Content="↶"
                                    Style="{StaticResource JogButton}" ToolTip="R 负向旋转" />
                            <Button Tag="R:1" Content="↷"
                                    Style="{StaticResource JogButton}" ToolTip="R 正向旋转" />
                        </StackPanel>
                        <TextBlock Text="R−　　R+" Foreground="#8FB2C9" FontSize="10"
                                   Margin="0,4,0,0" TextAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Column="7" Background="#294F68" />

                    <Grid Grid.Column="8" Margin="12,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="82" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="XY 速度（pulse/s）" Style="{StaticResource PanelLabel}" />
                        <TextBlock Grid.Column="2" Text="Z 速度（pulse/s）" Style="{StaticResource PanelLabel}" />
                        <TextBlock Grid.Column="4" Text="R 速度（pulse/s）" Style="{StaticResource PanelLabel}" />
                        <TextBox Grid.Row="1" x:Name="ManualJogXyVelocityTextBox"
                                 Text="100000" Style="{StaticResource PanelInput}"
                                 TextChanged="ManualJogSetting_Changed" />
                        <TextBox Grid.Row="1" Grid.Column="2" x:Name="ManualJogZVelocityTextBox"
                                 Text="50000" Style="{StaticResource PanelInput}"
                                 TextChanged="ManualJogSetting_Changed" />
                        <TextBox Grid.Row="1" Grid.Column="4" x:Name="ManualJogRVelocityTextBox"
                                 Text="50000" Style="{StaticResource PanelInput}"
                                 TextChanged="ManualJogSetting_Changed" />
                        <Button Grid.Row="1" Grid.Column="5"
                                x:Name="ManualJogStopButton"
                                Margin="8,0,0,0"
                                Content="停止"
                                Style="{StaticResource PanelButton}"
                                Background="#8E2029"
                                BorderBrush="#D90D16"
                                Click="ManualJogStop_Click" />
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="6"
                                   x:Name="ManualJogStatusText"
                                   Margin="0,7,0,0"
                                   Text="按住按钮运行，松开即减速停止"
                                   Foreground="#8FB2C9"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Visibility="Collapsed">
            <TextBox x:Name="CalibrationFilePathTextBox"
                     TextChanged="CalibrationFilePath_Changed" />
            <Button x:Name="ChooseCalibrationFileButton"
                    Click="ChooseCalibrationFile_Click" />
            <Button x:Name="ImportCalibrationFileButton"
                    Click="ImportCalibrationFile_Click" />
            <Button x:Name="LoadCalibrationProfileButton"
                    Click="LoadCalibrationProfile_Click" />
            <TextBlock x:Name="CalibrationProfilePathText" />
            <Button x:Name="SaveCalibrationProfileButton"
                    IsEnabled="False"
                    Click="SaveCalibrationProfile_Click" />
        </Grid>
    </Grid>
</UserControl>
