<UserControl x:Class="ControlHub.Views.Pages.VisualCalibrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:ControlHub.Views.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1600"
             d:DesignHeight="820">
    <Grid Margin="10,10,10,8" Background="#10263A">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12,0"
                Background="#163047"
                BorderBrush="#345269"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="VisionMaster 视觉标定工作台"
                               Foreground="#F4F8FB"
                               FontSize="16"
                               FontWeight="Bold" />
                    <Border Width="1" Height="20" Margin="12,0" Background="#45647A" />
                    <Ellipse x:Name="HostStatusIndicator"
                             Width="10"
                             Height="10"
                             Fill="#E0A21A" />
                    <TextBlock x:Name="HostStatusText"
                               Margin="8,0,0,0"
                               Text="正在准备 64 位标定工作台…"
                               Foreground="#D8E4EC"
                               FontSize="13"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="独立 x64 / .NET Framework 4.8 运行"
                           Foreground="#8297A8"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />

                <Button Grid.Column="2"
                        x:Name="RestartHostButton"
                        Content="重启工作台"
                        Height="30"
                        Padding="12,0"
                        Foreground="White"
                        Background="#294A64"
                        BorderBrush="#45647A"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        IsEnabled="False"
                        Click="RestartHost_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,6,0,0"
                Background="#202427"
                BorderBrush="#345269"
                BorderThickness="1"
                CornerRadius="4"
                ClipToBounds="True">
            <Grid>
                <controls:VisionMasterProcessHost x:Name="VisionHost"
                                                  Started="VisionHost_Started"
                                                  Failed="VisionHost_Failed"
                                                  Exited="VisionHost_Exited" />

                <StackPanel x:Name="HostPlaceholder"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock Text="VisionMaster 标定工作区"
                               Foreground="#F4F8FB"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Margin="0,8,0,0"
                               Text="正在启动官方流程配置控件，请稍候…"
                               Foreground="#AAB9C6"
                               FontSize="14"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
