<UserControl x:Class="ControlHub.Views.Pages.VisualCalibrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:ControlHub.Views.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1500"
             d:DesignHeight="820">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F8FB" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PanelLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AFC0CD" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="PanelInput" TargetType="TextBox">
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#10263A" />
            <Setter Property="Background" Value="#F7FAFC" />
            <Setter Property="BorderBrush" Value="#668198" />
        </Style>
        <Style x:Key="PanelComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#10263A" />
            <Setter Property="Background" Value="#F7FAFC" />
            <Setter Property="BorderBrush" Value="#668198" />
        </Style>
        <Style x:Key="PanelButton" TargetType="Button">
            <Setter Property="Height" Value="29" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0D6EE8" />
            <Setter Property="BorderBrush" Value="#0B5CC2" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="#10283C" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8" Background="#071D2F">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="10,0"
                Background="#071D2F"
                BorderBrush="#345269"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="视觉标定"
                               Foreground="#F4F8FB"
                               FontSize="21"
                               FontWeight="Bold" />
                    <Ellipse x:Name="HostStatusIndicator"
                             Width="12"
                             Height="12"
                             Margin="20,0,0,0"
                             Fill="#E0A21A" />
                    <TextBlock x:Name="HostStatusText"
                               Margin="9,0,0,0"
                               Text="正在准备视觉组件…"
                               Foreground="#D8E4EC"
                               FontSize="14"
                               VerticalAlignment="Center" />
                    <TextBlock Text="轴组"
                               Foreground="#AFC0CD"
                               FontSize="12"
                               Margin="18,0,8,0"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="AxisSetComboBox"
                              Width="138"
                              Height="34"
                              VerticalContentAlignment="Center"
                              SelectionChanged="AxisSet_SelectionChanged">
                        <ComboBoxItem Content="第一套轴 1/2" Tag="First" />
                        <ComboBoxItem Content="第二套轴 3/4" Tag="Second" />
                    </ComboBox>
                </StackPanel>
                <Button Grid.Column="2"
                        x:Name="RestartHostButton"
                        Content="重启视觉"
                        Height="38"
                        Padding="14,0"
                        Foreground="White"
                        Background="#0B2235"
                        BorderBrush="#45647A"
                        Cursor="Hand"
                        IsEnabled="False"
                        Click="RestartHost_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Visibility="Collapsed"
                    Padding="10"
                    Background="#163047"
                    BorderBrush="#345269"
                    BorderThickness="1"
                    CornerRadius="5">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCard}">
                            <Button x:Name="StartLivePreviewButton"
                                    Content="获取实时画面"
                                    Style="{StaticResource PanelButton}"
                                    Click="StartLivePreview_Click" />
                        </Border>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="第一套 XY 标定"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold" />
                            <TextBlock Grid.Column="1"
                                       Text="轴1=X　轴2=Y"
                                       Foreground="#8FB2C9"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="1　记录中心" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="轴1 X（pulse）" Style="{StaticResource PanelLabel}" />
                                        <Border Height="27" Background="#243E52" CornerRadius="2">
                                            <TextBlock x:Name="CenterXPulseText"
                                                       Text="未记录"
                                                       Foreground="#F4F8FB"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="轴2 Y（pulse）" Style="{StaticResource PanelLabel}" />
                                        <Border Height="27" Background="#243E52" CornerRadius="2">
                                            <TextBlock x:Name="CenterYPulseText"
                                                       Text="未记录"
                                                       Foreground="#F4F8FB"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="CenterVmText"
                                           Margin="0,4"
                                           Text="基准点 X：--　Y：--"
                                           Foreground="#49D17D"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center" />
                                <Button x:Name="RecordCenterButton"
                                        Content="记录当前中心"
                                        Style="{StaticResource PanelButton}"
                                        Click="RecordCenter_Click" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="2　九点参数" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="间距 X（pulse）" Style="{StaticResource PanelLabel}" />
                                        <TextBox x:Name="StepXPulsesTextBox"
                                                 Text="100000"
                                                 Style="{StaticResource PanelInput}"
                                                 TextChanged="CalibrationInput_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="间距 Y（pulse）" Style="{StaticResource PanelLabel}" />
                                        <TextBox x:Name="StepYPulsesTextBox"
                                                 Text="100000"
                                                 Style="{StaticResource PanelInput}"
                                                 TextChanged="CalibrationInput_Changed" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="OffsetVmText"
                                           Margin="0,3,0,4"
                                           Text="VisionMaster：X 10　Y 10"
                                           Foreground="#49D17D"
                                           FontSize="11"
                                           TextAlignment="Center" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="移动顺序" Style="{StaticResource PanelLabel}" />
                                        <ComboBox x:Name="MovePriorityComboBox"
                                                  Style="{StaticResource PanelComboBox}"
                                                  SelectedIndex="0"
                                                  SelectionChanged="MovePriority_SelectionChanged">
                                            <ComboBoxItem Content="X优先" Tag="X" />
                                            <ComboBoxItem Content="Y优先" Tag="Y" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="速度（pulse/s）" Style="{StaticResource PanelLabel}" />
                                        <TextBox x:Name="VelocityTextBox"
                                                 Text="100000"
                                                 Style="{StaticResource PanelInput}"
                                                 TextChanged="CalibrationSetting_Changed" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="到位等待（ms）"
                                               Style="{StaticResource PanelLabel}"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2"
                                             x:Name="SettleMillisecondsTextBox"
                                             Text="300"
                                             Style="{StaticResource PanelInput}"
                                             TextChanged="CalibrationSetting_Changed" />
                                </Grid>
                                <ProgressBar x:Name="CalibrationProgressBar"
                                             Margin="0,6,0,0"
                                             Height="5"
                                             Minimum="0"
                                             Maximum="9"
                                             Value="0" />
                                <TextBlock x:Name="WorkflowStatusText"
                                           Margin="0,4,0,4"
                                           MinHeight="20"
                                           MaxHeight="30"
                                           Text="请先记录中心坐标"
                                           Foreground="#D8E4EC"
                                           FontSize="11"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="68" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="StartCalibrationButton"
                                            Content="一键九点标定"
                                            Style="{StaticResource PanelButton}"
                                            Background="#17834A"
                                            BorderBrush="#12683A"
                                            IsEnabled="False"
                                            Click="StartCalibration_Click" />
                                    <Button Grid.Column="2"
                                            x:Name="StopCalibrationButton"
                                            Content="停止"
                                            Style="{StaticResource PanelButton}"
                                            Background="#D90D16"
                                            BorderBrush="#A90A12"
                                            IsEnabled="False"
                                            Click="StopCalibration_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="3　吸嘴对位"
                                               Style="{StaticResource SectionTitle}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               x:Name="NozzleTeachStepText"
                                               Text="等待记录十字"
                                               Foreground="#49D17D"
                                               FontSize="10"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="RecordCameraToolPointButton"
                                            Content="1 记录十字"
                                            Style="{StaticResource PanelButton}"
                                            Background="#294A64"
                                            BorderBrush="#45647A"
                                            FontSize="11"
                                            Click="RecordCameraToolPoint_Click" />
                                    <Button Grid.Column="2"
                                            x:Name="RecordNozzleToolPointButton"
                                            Content="2 记录吸嘴1"
                                            Style="{StaticResource PanelButton}"
                                            Background="#294A64"
                                            BorderBrush="#45647A"
                                            FontSize="11"
                                            IsEnabled="False"
                                            Click="RecordNozzleToolPoint_Click" />
                                </Grid>
                                <TextBlock x:Name="NozzleCalibrationStatusText"
                                           Margin="0,4,0,0"
                                           MaxHeight="30"
                                           Text="记录一次十字，再依次记录吸嘴1、吸嘴2"
                                           Foreground="#8FB2C9"
                                           FontSize="10"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}" Margin="0">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="4　点击移动"
                                               Style="{StaticResource SectionTitle}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="2"
                                              x:Name="ClickTargetToolComboBox"
                                              Style="{StaticResource PanelComboBox}"
                                              SelectionChanged="ClickTargetTool_SelectionChanged">
                                        <ComboBoxItem Content="相机中心对准" Tag="Camera" />
                                        <ComboBoxItem Content="吸嘴1中心对准" Tag="Nozzle1" />
                                        <ComboBoxItem Content="吸嘴2中心对准" Tag="Nozzle2" />
                                    </ComboBox>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="78" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="EnableClickMoveCheckBox"
                                              Foreground="#F4F8FB"
                                              FontWeight="SemiBold"
                                              Content="点击图像移动"
                                              VerticalAlignment="Center"
                                              Checked="EnableClickMove_Changed"
                                              Unchecked="EnableClickMove_Changed" />
                                    <Button Grid.Column="1"
                                            x:Name="StopClickMoveButton"
                                            Content="停止移动"
                                            Style="{StaticResource PanelButton}"
                                            Background="#D90D16"
                                            BorderBrush="#A90A12"
                                            IsEnabled="False"
                                            Click="StopClickMove_Click" />
                                </Grid>
                                <TextBlock x:Name="ClickMoveStatusText"
                                           Margin="0,4,0,0"
                                           MaxHeight="24"
                                           Text="未启用"
                                           Foreground="#8FB2C9"
                                           FontSize="10"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#202427"
                    BorderBrush="#345269"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True">
                <Grid>
                    <controls:VisionMasterProcessHost x:Name="VisionHost"
                                                      Started="VisionHost_Started"
                                                      Failed="VisionHost_Failed"
                                                      Exited="VisionHost_Exited"
                                                      CalibrationToolbarActionRequested="VisionHost_CalibrationToolbarActionRequested"
                                                      CalibrationSidebarActionRequested="VisionHost_CalibrationSidebarActionRequested"
                                                      ClickTargetReceived="VisionHost_ClickTargetReceived"
                                                      ClickTargetFailed="VisionHost_ClickTargetFailed" />
                    <StackPanel x:Name="HostPlaceholder"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock Text="视觉组件启动中…"
                                   Foreground="#AAB9C6"
                                   FontSize="14"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Visibility="Collapsed">
            <TextBox x:Name="CalibrationFilePathTextBox"
                     TextChanged="CalibrationFilePath_Changed" />
            <Button x:Name="ChooseCalibrationFileButton"
                    Click="ChooseCalibrationFile_Click" />
            <Button x:Name="ImportCalibrationFileButton"
                    Click="ImportCalibrationFile_Click" />
            <Button x:Name="LoadCalibrationProfileButton"
                    Click="LoadCalibrationProfile_Click" />
            <TextBlock x:Name="CalibrationProfilePathText" />
            <Button x:Name="SaveCalibrationProfileButton"
                    IsEnabled="False"
                    Click="SaveCalibrationProfile_Click" />
        </Grid>
    </Grid>
</UserControl>
