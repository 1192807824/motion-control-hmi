<UserControl x:Class="ControlHub.Views.Pages.VisualCalibrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:ControlHub.Views.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1500"
             d:DesignHeight="820">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F8FB" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PanelLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AFC0CD" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="PanelInput" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#10263A" />
            <Setter Property="Background" Value="#F7FAFC" />
            <Setter Property="BorderBrush" Value="#668198" />
        </Style>
        <Style x:Key="PanelComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#10263A" />
            <Setter Property="Background" Value="#F7FAFC" />
            <Setter Property="BorderBrush" Value="#668198" />
        </Style>
        <Style x:Key="PanelButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0D6EE8" />
            <Setter Property="BorderBrush" Value="#0B5CC2" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="#10283C" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8" Background="#10263A">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="10,0"
                Background="#163047"
                BorderBrush="#345269"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="视觉标定"
                               Foreground="#F4F8FB"
                               FontSize="15"
                               FontWeight="Bold" />
                    <Ellipse x:Name="HostStatusIndicator"
                             Width="9"
                             Height="9"
                             Margin="12,0,0,0"
                             Fill="#E0A21A" />
                    <TextBlock x:Name="HostStatusText"
                               Margin="6,0,0,0"
                               Text="正在准备视觉组件…"
                               Foreground="#D8E4EC"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="2"
                        x:Name="RestartHostButton"
                        Content="重启视觉"
                        Height="28"
                        Padding="10,0"
                        Foreground="White"
                        Background="#294A64"
                        BorderBrush="#45647A"
                        Cursor="Hand"
                        IsEnabled="False"
                        Click="RestartHost_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MaxWidth="1050" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="10"
                    Background="#163047"
                    BorderBrush="#345269"
                    BorderThickness="1"
                    CornerRadius="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="第一套 XY 标定"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold" />
                            <TextBlock Grid.Column="1"
                                       Text="轴1=X　轴2=Y"
                                       Foreground="#8FB2C9"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="1　记录中心" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="轴1 X（pulse）" Style="{StaticResource PanelLabel}" />
                                        <Border Height="29" Background="#243E52" CornerRadius="2">
                                            <TextBlock x:Name="CenterXPulseText"
                                                       Text="未记录"
                                                       Foreground="#F4F8FB"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="轴2 Y（pulse）" Style="{StaticResource PanelLabel}" />
                                        <Border Height="29" Background="#243E52" CornerRadius="2">
                                            <TextBlock x:Name="CenterYPulseText"
                                                       Text="未记录"
                                                       Foreground="#F4F8FB"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="CenterVmText"
                                           Margin="0,6"
                                           Text="基准点 X：--　Y：--"
                                           Foreground="#49D17D"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center" />
                                <Button x:Name="RecordCenterButton"
                                        Content="记录当前中心"
                                        Style="{StaticResource PanelButton}"
                                        Click="RecordCenter_Click" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="2　九点参数" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="间距 X（pulse）" Style="{StaticResource PanelLabel}" />
                                        <TextBox x:Name="StepXPulsesTextBox"
                                                 Text="100000"
                                                 Style="{StaticResource PanelInput}"
                                                 TextChanged="CalibrationInput_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="间距 Y（pulse）" Style="{StaticResource PanelLabel}" />
                                        <TextBox x:Name="StepYPulsesTextBox"
                                                 Text="100000"
                                                 Style="{StaticResource PanelInput}"
                                                 TextChanged="CalibrationInput_Changed" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="OffsetVmText"
                                           Margin="0,5,0,7"
                                           Text="VisionMaster：X 10　Y 10"
                                           Foreground="#49D17D"
                                           FontSize="11"
                                           TextAlignment="Center" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="移动顺序" Style="{StaticResource PanelLabel}" />
                                        <ComboBox x:Name="MovePriorityComboBox"
                                                  Style="{StaticResource PanelComboBox}"
                                                  SelectedIndex="0"
                                                  SelectionChanged="MovePriority_SelectionChanged">
                                            <ComboBoxItem Content="X优先" Tag="X" />
                                            <ComboBoxItem Content="Y优先" Tag="Y" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="速度（pulse/s）" Style="{StaticResource PanelLabel}" />
                                        <TextBox x:Name="VelocityTextBox"
                                                 Text="100000"
                                                 Style="{StaticResource PanelInput}"
                                                 TextChanged="CalibrationSetting_Changed" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="到位等待（ms）"
                                               Style="{StaticResource PanelLabel}"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2"
                                             x:Name="SettleMillisecondsTextBox"
                                             Text="300"
                                             Style="{StaticResource PanelInput}"
                                             TextChanged="CalibrationSetting_Changed" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="3　标定文件" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="62" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CalibrationFilePathTextBox"
                                             Style="{StaticResource PanelInput}"
                                             TextAlignment="Left"
                                             TextChanged="CalibrationFilePath_Changed"
                                             ToolTip="标定文件保存位置" />
                                    <Button Grid.Column="2"
                                            x:Name="ChooseCalibrationFileButton"
                                            Content="选择"
                                            Style="{StaticResource PanelButton}"
                                            Background="#294A64"
                                            BorderBrush="#45647A"
                                            Click="ChooseCalibrationFile_Click" />
                                </Grid>
                                <ProgressBar x:Name="CalibrationProgressBar"
                                             Margin="0,8,0,0"
                                             Height="6"
                                             Minimum="0"
                                             Maximum="9"
                                             Value="0" />
                                <TextBlock x:Name="WorkflowStatusText"
                                           Margin="0,6,0,8"
                                           MinHeight="30"
                                           MaxHeight="48"
                                           Text="请先记录中心坐标"
                                           Foreground="#D8E4EC"
                                           FontSize="11"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="68" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="StartCalibrationButton"
                                            Content="一键九点标定"
                                            Style="{StaticResource PanelButton}"
                                            Background="#17834A"
                                            BorderBrush="#12683A"
                                            IsEnabled="False"
                                            Click="StartCalibration_Click" />
                                    <Button Grid.Column="2"
                                            x:Name="StopCalibrationButton"
                                            Content="停止"
                                            Style="{StaticResource PanelButton}"
                                            Background="#D90D16"
                                            BorderBrush="#A90A12"
                                            IsEnabled="False"
                                            Click="StopCalibration_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}" Margin="0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="78" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="EnableClickMoveCheckBox"
                                              Foreground="#F4F8FB"
                                              FontWeight="SemiBold"
                                              Content="点击图像移动"
                                              VerticalAlignment="Center"
                                              Checked="EnableClickMove_Changed"
                                              Unchecked="EnableClickMove_Changed" />
                                    <Button Grid.Column="1"
                                            x:Name="StopClickMoveButton"
                                            Content="停止移动"
                                            Style="{StaticResource PanelButton}"
                                            Background="#D90D16"
                                            BorderBrush="#A90A12"
                                            IsEnabled="False"
                                            Click="StopClickMove_Click" />
                                </Grid>
                                <TextBlock x:Name="ClickMoveStatusText"
                                           Margin="0,6,0,0"
                                           MaxHeight="34"
                                           Text="未启用"
                                           Foreground="#8FB2C9"
                                           FontSize="10"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2"
                    Background="#202427"
                    BorderBrush="#345269"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True">
                <Grid>
                    <controls:VisionMasterProcessHost x:Name="VisionHost"
                                                      Started="VisionHost_Started"
                                                      Failed="VisionHost_Failed"
                                                      Exited="VisionHost_Exited"
                                                      ClickTargetReceived="VisionHost_ClickTargetReceived"
                                                      ClickTargetFailed="VisionHost_ClickTargetFailed" />
                    <StackPanel x:Name="HostPlaceholder"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock Text="视觉组件启动中…"
                                   Foreground="#AAB9C6"
                                   FontSize="14"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
