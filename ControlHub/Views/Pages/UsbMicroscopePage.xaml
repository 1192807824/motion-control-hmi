<UserControl x:Class="ControlHub.Views.Pages.UsbMicroscopePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1500"
             d:DesignHeight="820"
             Loaded="UsbMicroscopePage_Loaded">
    <UserControl.Resources>
        <Style x:Key="MicroscopeLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AFC0CD" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MicroscopeComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Foreground" Value="#10263A" />
            <Setter Property="Background" Value="#F7FAFC" />
            <Setter Property="BorderBrush" Value="#668198" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="MicroscopeButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0D6EE8" />
            <Setter Property="BorderBrush" Value="#2587F4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8" Background="#071D2F">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14,0"
                Background="#071D2F"
                BorderBrush="#345269"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="USB 显微镜"
                               Foreground="#F4F8FB"
                               FontSize="21"
                               FontWeight="Bold" />
                    <Ellipse x:Name="ConnectionStatusIndicator"
                             Width="11"
                             Height="11"
                             Margin="18,0,0,0"
                             Fill="#6F8190" />
                    <TextBlock x:Name="ConnectionStatusText"
                               Margin="8,0,0,0"
                               Text="等待检测显微镜"
                               Foreground="#D8E4EC"
                               FontSize="13"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="滚轮缩放；圆选至少 3 点，矩形/正方形任选 4 个角点；生成后可拖动"
                           Foreground="#8FB2C9"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,7,0,7"
                Padding="12,0"
                Background="#10283C"
                BorderBrush="#345269"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="290" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="显微镜设备" Style="{StaticResource MicroscopeLabel}" />
                <ComboBox x:Name="DeviceComboBox"
                          Grid.Column="1"
                          Margin="8,0,16,0"
                          Style="{StaticResource MicroscopeComboBox}"
                          DisplayMemberPath="Name"
                          SelectionChanged="Device_SelectionChanged" />
                <TextBlock Grid.Column="2" Text="分辨率" Style="{StaticResource MicroscopeLabel}" />
                <ComboBox x:Name="ModeComboBox"
                          Grid.Column="3"
                          Margin="8,0,0,0"
                          Style="{StaticResource MicroscopeComboBox}"
                          DisplayMemberPath="Description" />

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshDevicesButton"
                            Content="刷新设备"
                            Style="{StaticResource MicroscopeButton}"
                            Background="#294A64"
                            BorderBrush="#45647A"
                            Click="RefreshDevices_Click" />
                    <Button x:Name="ConnectButton"
                            Content="连接显微镜"
                            Style="{StaticResource MicroscopeButton}"
                            Click="Connect_Click" />
                    <Button x:Name="DisconnectButton"
                            Content="断开"
                            Style="{StaticResource MicroscopeButton}"
                            Background="#C9363E"
                            BorderBrush="#E45A61"
                            IsEnabled="False"
                            Click="Disconnect_Click" />
                    <Button x:Name="DevicePropertiesButton"
                            Content="显微镜参数"
                            Style="{StaticResource MicroscopeButton}"
                            Background="#294A64"
                            BorderBrush="#45647A"
                            IsEnabled="False"
                            Click="DeviceProperties_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl x:Name="DefaultPreviewHost"
                        Grid.Row="2"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
            <Grid x:Name="MicroscopeWorkspace" Background="#0B1D2B">
                <Grid.Resources>
                    <Style x:Key="AnnotationButton" TargetType="Button" BasedOn="{StaticResource MicroscopeButton}">
                        <Setter Property="Height" Value="28" />
                        <Setter Property="MinWidth" Value="64" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Padding" Value="7,0" />
                        <Setter Property="Margin" Value="3" />
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel Margin="4,3">
                    <Button x:Name="DrawCircleButton"
                            Content="点选圆"
                            Style="{StaticResource AnnotationButton}"
                            Background="#7A4DB3"
                            BorderBrush="#A273D7"
                            IsEnabled="False"
                            Click="DrawCircle_Click" />
                    <Button x:Name="DrawRectangleButton"
                            Content="点选矩形"
                            Style="{StaticResource AnnotationButton}"
                            Background="#187F94"
                            BorderBrush="#36ABC0"
                            IsEnabled="False"
                            Click="DrawRectangle_Click" />
                    <Button x:Name="UndoPointButton"
                            Content="撤销点"
                            Style="{StaticResource AnnotationButton}"
                            Background="#294A64"
                            BorderBrush="#45647A"
                            IsEnabled="False"
                            Click="UndoPoint_Click" />
                    <Button x:Name="ClearAnnotationButton"
                            Content="清除标记"
                            Style="{StaticResource AnnotationButton}"
                            Background="#294A64"
                            BorderBrush="#45647A"
                            IsEnabled="False"
                            Click="ClearAnnotation_Click" />
                    <Button x:Name="RotateDdButton"
                            Content="转动一次"
                            ToolTip="DD 马达轴正向移动 22500 脉冲"
                            Style="{StaticResource AnnotationButton}"
                            Background="#C66A12"
                            BorderBrush="#E58B33"
                            IsEnabled="False"
                            Click="RotateDdOnce_Click" />
                    <Button x:Name="CaptureButton"
                            Content="拍照保存"
                            Style="{StaticResource AnnotationButton}"
                            Background="#0A8A57"
                            BorderBrush="#19B978"
                            IsEnabled="False"
                            Click="Capture_Click" />
                </WrapPanel>
                <TextBlock x:Name="AnnotationStatusText"
                           Grid.Row="1"
                           Margin="8,0,8,5"
                           Text="请先在“USB显微镜”页面连接设备"
                           Foreground="#AFC0CD"
                           FontSize="11"
                           TextWrapping="Wrap" />
                <Border Grid.Row="2"
                        Background="#11171C"
                        BorderBrush="#345269"
                        BorderThickness="1"
                        CornerRadius="4"
                        ClipToBounds="True">
                    <Grid x:Name="PreviewSurface"
                          Background="Transparent"
                          PreviewMouseWheel="PreviewSurface_PreviewMouseWheel">
                        <Grid x:Name="ZoomContent">
                            <Image x:Name="PreviewImage"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <Canvas x:Name="AnnotationCanvas"
                                    Background="Transparent"
                                    IsHitTestVisible="False"
                                    SizeChanged="AnnotationCanvas_SizeChanged"
                                    MouseLeftButtonDown="AnnotationCanvas_MouseLeftButtonDown"
                                    MouseMove="AnnotationCanvas_MouseMove"
                                    MouseLeftButtonUp="AnnotationCanvas_MouseLeftButtonUp">
                                <Ellipse x:Name="CircleAnnotationEllipse"
                                         Visibility="Collapsed"
                                         Stroke="#FF3B42"
                                         StrokeThickness="3"
                                         Fill="#18FF3B42"
                                         IsHitTestVisible="False" />
                                <Polygon x:Name="RectangleAnnotationPolygon"
                                         Visibility="Collapsed"
                                         Stroke="#35D5FF"
                                         StrokeThickness="3"
                                         Fill="#1835D5FF"
                                         IsHitTestVisible="False" />
                            </Canvas>
                        </Grid>

                        <StackPanel x:Name="PreviewPlaceholder"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <TextBlock Text="USB"
                                       Foreground="#5C7487"
                                       FontSize="38"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="连接后可点选圆、矩形或正方形"
                                       Margin="10,10,10,0"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="#91A6B7"
                                       FontSize="11"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="8,8,72,8"
                                Padding="10,5"
                                Background="#B8071D2F"
                                CornerRadius="3">
                            <TextBlock x:Name="FrameStatusText"
                                       Text="尚未接收画面"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="#D8E4EC"
                                       FontSize="10" />
                        </Border>

                        <Button x:Name="ResetZoomButton"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,12,12"
                                Padding="10,5"
                                Content="100%"
                                ToolTip="点击恢复 100% 显示"
                                Foreground="#DCEAF3"
                                Background="#B21A2D3B"
                                BorderBrush="#60798C"
                                Cursor="Hand"
                                IsEnabled="False"
                                Click="ResetZoom_Click" />
                    </Grid>
                </Border>
            </Grid>
        </ContentControl>
    </Grid>
</UserControl>
