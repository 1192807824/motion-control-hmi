<UserControl x:Class="ControlHub.Views.Pages.MachineVisionPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vmControls="clr-namespace:VMControls.WPF.Release;assembly=VMControls.WPF.Release"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="680"
             Loaded="MachineVisionPage_Loaded"
             Unloaded="MachineVisionPage_Unloaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBorder" Color="#B9C1CB" />
        <SolidColorBrush x:Key="PanelTitle" Color="#003B73" />

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#F3F6FA" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PanelTitle}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="VisionInput" TargetType="TextBox">
            <Setter Property="Height" Value="29" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#B9C1CB" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="VisionCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="29" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="VisionButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#1F5F9F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#174E83" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="CenteredDataGridText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD2DA" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="#CDD3DA" />
            <Setter Property="VerticalGridLinesBrush" Value="#CDD3DA" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF2F6" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="30" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Panel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="■ VisionMaster 九点标定" Style="{StaticResource SectionTitle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="108" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="78" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="方案文件" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="VisionSolutionPathTextBox"
                                 Grid.Row="0" Grid.Column="1"
                                 Style="{StaticResource VisionInput}"
                                 Text="{Binding VisionSettings.SolutionPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="0" Grid.Column="2" Content="选择"
                                Style="{StaticResource VisionButton}" Margin="6,0,0,9"
                                Click="BrowseVisionSolution_Click" />

                        <TextBlock Grid.Row="1" Text="流程名称" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                 Style="{StaticResource VisionInput}"
                                 Text="{Binding VisionSettings.ProcedureName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Text="N点标定模块" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                 Style="{StaticResource VisionInput}"
                                 ToolTip="填写模块完整路径，例如：流程1.N点标定1"
                                 Text="{Binding VisionSettings.NPointCalibrationModuleName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="3" Text="图像点 X 输出" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                 Style="{StaticResource VisionInput}"
                                 Text="{Binding VisionSettings.PointXOutputName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="4" Text="图像点 Y 输出" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                 Style="{StaticResource VisionInput}"
                                 Text="{Binding VisionSettings.PointYOutputName, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,3,0,2">
                            <Button Content="加载方案" Style="{StaticResource VisionButton}" Click="LoadVisionSolution_Click" />
                            <Button Content="测试取点" Style="{StaticResource VisionButton}" Click="RunVisionOnce_Click" />
                            <TextBlock Text="图像由 VmRenderControl 显示" Foreground="#52606D"
                                       VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,8,0,10" />
                    <TextBlock Text="运动与文件参数" Style="{StaticResource SectionTitle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="108" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="108" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="X 运动轴" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="XAxisComboBox" Grid.Row="0" Grid.Column="1"
                                  Style="{StaticResource VisionCombo}"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="HardwareAxisNo" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Y 运动轴" Style="{StaticResource FieldLabel}" Margin="12,0,8,0" />
                        <ComboBox x:Name="YAxisComboBox" Grid.Row="0" Grid.Column="3"
                                  Style="{StaticResource VisionCombo}"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="HardwareAxisNo" />

                        <TextBlock Grid.Row="1" Text="X 每步距离" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="StepXTextBox" Grid.Row="1" Grid.Column="1" Text="10" Style="{StaticResource VisionInput}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Y 每步距离" Style="{StaticResource FieldLabel}" Margin="12,0,8,0" />
                        <TextBox x:Name="StepYTextBox" Grid.Row="1" Grid.Column="3" Text="10" Style="{StaticResource VisionInput}" />

                        <TextBlock Grid.Row="2" Text="移动速度" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="VelocityTextBox" Grid.Row="2" Grid.Column="1" Text="20" Style="{StaticResource VisionInput}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="稳定等待(ms)" Style="{StaticResource FieldLabel}" Margin="12,0,8,0" />
                        <TextBox x:Name="SettleTextBox" Grid.Row="2" Grid.Column="3" Text="300" Style="{StaticResource VisionInput}" />

                        <TextBlock Grid.Row="3" Text="输出标定文件" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="CalibrationFilePathTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                 Style="{StaticResource VisionInput}" />
                        <Button Grid.Row="3" Grid.Column="3" Content="选择位置"
                                Style="{StaticResource VisionButton}" Margin="6,0,0,9"
                                Click="BrowseCalibrationFile_Click" />
                    </Grid>

                    <Border Background="#E8F2FC" BorderBrush="#9BBBDD" BorderThickness="1"
                            CornerRadius="4" Padding="9" Margin="0,9,0,10">
                        <TextBlock TextWrapping="Wrap" Foreground="#163B5C"
                                   Text="以开始时坐标为中心走 3×3 九点。第 9 点回到起始中心；任一点取图或运动失败都会停止所选两轴。开始前请确认行程内无干涉。" />
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="StartCalibrationButton" Content="一键九点标定"
                                Style="{StaticResource VisionButton}" Width="150"
                                Background="#08783E" BorderBrush="#086733"
                                Click="StartCalibration_Click" />
                        <Button x:Name="CancelCalibrationButton" Content="停止标定"
                                Style="{StaticResource VisionButton}" Width="110"
                                Background="#BC100B" BorderBrush="#94100C"
                                IsEnabled="False" Click="CancelCalibration_Click" />
                    </StackPanel>

                    <ProgressBar x:Name="CalibrationProgressBar" Height="18" Minimum="0" Maximum="9"
                                 Margin="0,10,0,4" />
                    <TextBlock x:Name="CalibrationProgressText" Text="等待开始" Foreground="#334155" />
                    <TextBlock Text="{Binding VisionStatusText}" Foreground="#0F5132" FontWeight="SemiBold"
                               Margin="0,6,0,2" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding VisionRunTimeText, StringFormat=最近取点耗时：{0}}"
                               Foreground="#475569" />

                    <ItemsControl ItemsSource="{Binding VisionLogs}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="#4B5563"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="230" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="■ VisionMaster 图像与结果" Style="{StaticResource SectionTitle}" />
                    <vmControls:VmRenderControl x:Name="VisionRenderControl"
                                                Grid.Row="1"
                                                CoordinateInfoVisible="True" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="■ 九点采集结果" Style="{StaticResource SectionTitle}" />
                    <DataGrid x:Name="CalibrationSamplesGrid" Grid.Row="1" RowHeight="27" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="38" ElementStyle="{StaticResource CenteredDataGridText}" />
                            <DataGridTextColumn Header="目标 X" Binding="{Binding TargetMachineX, StringFormat=0.###}" Width="*" ElementStyle="{StaticResource CenteredDataGridText}" />
                            <DataGridTextColumn Header="目标 Y" Binding="{Binding TargetMachineY, StringFormat=0.###}" Width="*" ElementStyle="{StaticResource CenteredDataGridText}" />
                            <DataGridTextColumn Header="实际 X" Binding="{Binding ActualMachineX, StringFormat=0.###}" Width="*" ElementStyle="{StaticResource CenteredDataGridText}" />
                            <DataGridTextColumn Header="实际 Y" Binding="{Binding ActualMachineY, StringFormat=0.###}" Width="*" ElementStyle="{StaticResource CenteredDataGridText}" />
                            <DataGridTextColumn Header="图像 X" Binding="{Binding ImageX, StringFormat=0.###}" Width="*" ElementStyle="{StaticResource CenteredDataGridText}" />
                            <DataGridTextColumn Header="图像 Y" Binding="{Binding ImageY, StringFormat=0.###}" Width="*" ElementStyle="{StaticResource CenteredDataGridText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
