<UserControl x:Class="ControlHub.Views.Pages.ConnectionConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="680"
             Loaded="ConnectionConfigPage_Loaded"
             Unloaded="ConnectionConfigPage_Unloaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBorder" Color="#BAC4CF" />
        <SolidColorBrush x:Key="PanelFill" Color="#F7F9FC" />
        <SolidColorBrush x:Key="PanelHeader" Color="#EDF2F7" />
        <SolidColorBrush x:Key="AccentBlue" Color="#1F5F9F" />
        <SolidColorBrush x:Key="AccentGreen" Color="#168500" />
        <SolidColorBrush x:Key="AccentRed" Color="#BC100B" />
        <SolidColorBrush x:Key="MutedText" Color="#64748B" />
        <SolidColorBrush x:Key="DarkText" Color="#101827" />

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F3554" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="ConfigInput" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#B9C1CB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource DarkText}" />
        </Style>

        <Style x:Key="ConfigCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#B9C1CB" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBlue}" />
            <Setter Property="BorderBrush" Value="#174E83" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="#17324A" />
            <Setter Property="Background" Value="#E8EEF5" />
            <Setter Property="BorderBrush" Value="#AEB9C5" />
        </Style>

        <Style x:Key="ConnectionItem" TargetType="Border">
            <Setter Property="Height" Value="74" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CED7E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="ActiveConnectionItem" TargetType="Border" BasedOn="{StaticResource ConnectionItem}">
            <Setter Property="Background" Value="#E9F2FB" />
            <Setter Property="BorderBrush" Value="#1F5F9F" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DarkText}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ConfigCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10,10,10,8" Background="#E8EDF2">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource Panel}"
                Background="#F9FBFD"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="&#x8FDE;&#x63A5;&#x914D;&#x7F6E;&#x4E2D;&#x5FC3;"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#0B2238" />
                    <TextBlock Text="TCP / IO / PLC"
                               Margin="0,4,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedText}" />
                </StackPanel>

                <Border Grid.Column="1"
                        Height="42"
                        Padding="12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#ECFDF3"
                        BorderBrush="#84C78B"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#16A34A" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding FeederConnectionStatusText}"
                                   Width="286"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#14532D"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="&#x8FDE;&#x63A5;&#x5BF9;&#x8C61;" Style="{StaticResource PanelTitle}" />

                    <StackPanel Grid.Row="1">
                        <Border Style="{StaticResource ActiveConnectionItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        Background="#1F5F9F"
                                        CornerRadius="4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="TCP"
                                               Foreground="White"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="&#x9707;&#x52A8;&#x76D8;"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#0F172A" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#1F5F9F">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="TCP  {0}:{1}">
                                                <Binding Path="FeederSettings.Host" />
                                                <Binding Path="FeederSettings.Port" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ConnectionItem}" Opacity="0.62">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        Background="#CBD5E1"
                                        CornerRadius="4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="TCP"
                                               Foreground="#334155"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="PLC"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#334155" />
                                    <TextBlock Text="Modbus TCP"
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#64748B" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ConnectionItem}" Opacity="0.62">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        Background="#CBD5E1"
                                        CornerRadius="4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="USB"
                                               Foreground="#334155"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="&#x626B;&#x7801;&#x67AA;"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#334155" />
                                    <TextBlock Text="USB HID / COM"
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#64748B" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Button Grid.Row="2"
                            Content="&#x4FDD;&#x5B58; TCP &#x914D;&#x7F6E;"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch"
                            Margin="0"
                            Click="SaveSettings_Click" />
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="82" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="330" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#x8BBE;&#x5907;" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="&#x9707;&#x52A8;&#x76D8;" Style="{StaticResource MetricValue}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="&#x8BBE;&#x5907;&#x5730;&#x5740;" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding FeederSettings.Host}" Style="{StaticResource MetricValue}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="TCP &#x7AEF;&#x53E3;" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding FeederSettings.Port}" Style="{StaticResource MetricValue}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock Text="&#x534F;&#x8BAE;" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="TCP Client" Style="{StaticResource MetricValue}" Margin="0,6,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="4"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Content="&#x4FDD;&#x5B58;"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="SaveSettings_Click" />
                            <Button Content="&#x8FDE;&#x63A5;"
                                    Style="{StaticResource PrimaryButton}"
                                    Background="{StaticResource AccentGreen}"
                                    BorderBrush="#126700"
                                    Click="ConnectFeeder_Click" />
                            <Button Content="&#x65AD;&#x5F00;"
                                    Style="{StaticResource PrimaryButton}"
                                    Background="#5F6B7A"
                                    BorderBrush="#4B5563"
                                    Margin="0"
                                    Click="DisconnectFeeder_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="560" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="220" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource PanelHeader}"
                                    BorderBrush="{StaticResource PanelBorder}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="6,6,0,0"
                                    Padding="14,0">
                                <TextBlock Text="TCP &#x5BA2;&#x6237;&#x7AEF;&#x53C2;&#x6570;" Style="{StaticResource PanelTitle}" />
                            </Border>

                            <Grid Grid.Row="1" Margin="14,12,14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="42" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="&#x8BBE;&#x5907;&#x5730;&#x5740;" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="0"
                                             Grid.Column="1"
                                             Style="{StaticResource ConfigInput}"
                                             Text="{Binding FeederSettings.Host, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="TCP &#x7AEF;&#x53E3;" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="0"
                                             Grid.Column="4"
                                             Style="{StaticResource ConfigInput}"
                                             Text="{Binding FeederSettings.Port, UpdateSourceTrigger=LostFocus}" />

                                    <TextBlock Grid.Row="1" Text="&#x8FDE;&#x63A5;&#x8D85;&#x65F6;" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="1"
                                             Grid.Column="1"
                                             Style="{StaticResource ConfigInput}"
                                             Text="{Binding FeederSettings.ConnectTimeoutMs, UpdateSourceTrigger=LostFocus}" />

                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="&#x5199;&#x8D85;&#x65F6;" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="1"
                                             Grid.Column="4"
                                             Style="{StaticResource ConfigInput}"
                                             Text="{Binding FeederSettings.WriteTimeoutMs, UpdateSourceTrigger=LostFocus}" />

                                    <TextBlock Grid.Row="2" Text="&#x7ED3;&#x675F;&#x7B26;" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="2"
                                             Grid.Column="1"
                                             Grid.ColumnSpan="4"
                                             Style="{StaticResource ConfigInput}"
                                             Text="{Binding FeederSettings.NewLine, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="92" />
                                <RowDefinition Height="52" />
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource PanelHeader}"
                                    BorderBrush="{StaticResource PanelBorder}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="6,6,0,0"
                                    Padding="14,0">
                                <TextBlock Text="&#x6570;&#x636E;&#x6536;&#x53D1;" Style="{StaticResource PanelTitle}" />
                            </Border>

                            <TextBox Grid.Row="1"
                                     Margin="14,12,14,0"
                                     Padding="10,8"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     BorderBrush="#B9C1CB"
                                     Background="#FFFFFF"
                                     Foreground="#0F172A"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     Text="{Binding FeederSettings.ManualSendText, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Grid.Row="2" Margin="14,10,14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="36" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="&#x53D1;&#x9001;&#x683C;&#x5F0F;" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Row="0"
                                          Grid.Column="1"
                                          Style="{StaticResource ConfigCombo}"
                                          SelectedValuePath="Content"
                                          SelectedValue="{Binding FeederSettings.SendFormat, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBoxItem Content="ASCII" />
                                    <ComboBoxItem Content="UTF-8" />
                                    <ComboBoxItem Content="GB2312" />
                                    <ComboBoxItem Content="HEX" />
                                </ComboBox>

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="&#x63A5;&#x6536;&#x683C;&#x5F0F;" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Row="0"
                                          Grid.Column="4"
                                          Style="{StaticResource ConfigCombo}"
                                          SelectedValuePath="Content"
                                          SelectedValue="{Binding FeederSettings.ReceiveFormat, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBoxItem Content="ASCII" />
                                    <ComboBoxItem Content="UTF-8" />
                                    <ComboBoxItem Content="GB2312" />
                                    <ComboBoxItem Content="HEX" />
                                </ComboBox>

                                <CheckBox Grid.Row="1"
                                          Grid.Column="1"
                                          Grid.ColumnSpan="4"
                                          Style="{StaticResource ConfigCheckBox}"
                                          Content="&#x53D1;&#x9001;&#x65F6;&#x8FFD;&#x52A0;&#x7ED3;&#x675F;&#x7B26;"
                                          IsChecked="{Binding FeederSettings.AppendNewLine, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <StackPanel Grid.Row="3"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="14,8,6,12">
                                <Button Content="&#x53D1;&#x9001;"
                                        Style="{StaticResource PrimaryButton}"
                                        Background="{StaticResource AccentGreen}"
                                        BorderBrush="#126700"
                                        Click="SendManualMessage_Click" />
                                <Button Content="&#x505C;&#x6B62;&#x9707;&#x52A8;"
                                        Style="{StaticResource PrimaryButton}"
                                        Background="{StaticResource AccentRed}"
                                        BorderBrush="#9E0B08"
                                        Click="StopVibration_Click" />
                                <Button Content="&#x6E05;&#x7A7A;&#x65E5;&#x5FD7;"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="ClearLog_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    </Grid>

                <Border Grid.Column="2" Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource PanelHeader}"
                                BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="6,6,0,0"
                                Padding="14,0">
                            <TextBlock Text="&#x901A;&#x8BAF;&#x65E5;&#x5FD7;" Style="{StaticResource PanelTitle}" />
                        </Border>

                        <ListBox x:Name="ConnectionLogListBox"
                                 Grid.Row="1"
                                 ItemsSource="{Binding FeederConnectionLogs}"
                                 BorderThickness="0"
                                 Background="#FBFCFE"
                                 Padding="8"
                                 FontSize="13">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Foreground="#334155"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
