<UserControl x:Class="ControlHub.Views.Pages.ConnectionConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="680"
             Loaded="ConnectionConfigPage_Loaded"
             Unloaded="ConnectionConfigPage_Unloaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBorder" Color="#345269" />
        <SolidColorBrush x:Key="PanelFill" Color="#163047" />
        <SolidColorBrush x:Key="PanelHeader" Color="#1B374F" />
        <SolidColorBrush x:Key="AccentBlue" Color="#0D6EE8" />
        <SolidColorBrush x:Key="AccentGreen" Color="#1B8F4D" />
        <SolidColorBrush x:Key="AccentRed" Color="#D90D16" />
        <SolidColorBrush x:Key="MutedText" Color="#AAB9C6" />
        <SolidColorBrush x:Key="DarkText" Color="#F4F8FB" />

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F8FB" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#AAB9C6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="ConfigInput" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#45647A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#132B40" />
            <Setter Property="Foreground" Value="#F4F8FB" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBlue}" />
            <Setter Property="BorderBrush" Value="#0B5CC2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="#F4F8FB" />
            <Setter Property="Background" Value="#294A64" />
            <Setter Property="BorderBrush" Value="#45647A" />
        </Style>

        <Style x:Key="ConnectionItem" TargetType="Border">
            <Setter Property="Height" Value="74" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Background" Value="#1B374F" />
            <Setter Property="BorderBrush" Value="#345269" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="ActiveConnectionItem" TargetType="Border" BasedOn="{StaticResource ConnectionItem}">
            <Setter Property="Background" Value="#0C4C88" />
            <Setter Property="BorderBrush" Value="#0D6EE8" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DarkText}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ConfigCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D8E4EC" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="BrightnessStepButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#62B5FF" />
            <Setter Property="Background" Value="#294A64" />
            <Setter Property="BorderBrush" Value="#45647A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#365C78" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0D6EE8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0D6EE8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrightnessSlider" TargetType="Slider">
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="36" VerticalAlignment="Center">
                            <Border Height="12"
                                    VerticalAlignment="Center"
                                    Background="#294A64"
                                    BorderBrush="#45647A"
                                    BorderThickness="1"
                                    CornerRadius="6" />
                            <Track x:Name="PART_Track"
                                   Height="26"
                                   VerticalAlignment="Center"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="12"
                                                        VerticalAlignment="Center"
                                                        Background="#0D6EE8"
                                                        CornerRadius="6,0,0,6" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="24" Height="24" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="#F7FAFC"
                                                             Stroke="#0D6EE8"
                                                             StrokeThickness="3" />
                                                    <Ellipse Width="8" Height="8" Fill="#0D6EE8" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="1.08" ScaleY="1.08" />
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10,10,10,8" Background="#10263A">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource Panel}"
                Background="#163047"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="&#x8FDE;&#x63A5;&#x914D;&#x7F6E;&#x4E2D;&#x5FC3;"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#F4F8FB" />
                </StackPanel>

                <Border Grid.Column="1"
                        Height="42"
                        Padding="12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#132B40"
                        BorderBrush="#345269"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#39C56B" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding FeederConnectionStatusText}"
                                   Width="286"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#62B5FF"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="&#x8FDE;&#x63A5;&#x5BF9;&#x8C61;" Style="{StaticResource PanelTitle}" />

                    <StackPanel Grid.Row="1">
                        <Border Style="{StaticResource ActiveConnectionItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        Background="#0D6EE8"
                                        CornerRadius="4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="TCP"
                                               Foreground="White"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="&#x9707;&#x52A8;&#x76D8;"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#F4F8FB" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#62B5FF">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="TCP  {0}:{1}">
                                                <Binding Path="FeederSettings.Host" />
                                                <Binding Path="FeederSettings.Port" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>

                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="82" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="330" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#x8BBE;&#x5907;" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="&#x9707;&#x52A8;&#x76D8;" Style="{StaticResource MetricValue}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="&#x8BBE;&#x5907;&#x5730;&#x5740;" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding FeederSettings.Host}" Style="{StaticResource MetricValue}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="TCP &#x7AEF;&#x53E3;" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding FeederSettings.Port}" Style="{StaticResource MetricValue}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock Text="&#x534F;&#x8BAE;" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="TCP Client" Style="{StaticResource MetricValue}" Margin="0,6,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="4"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Content="&#x4FDD;&#x5B58;"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="SaveSettings_Click" />
                            <Button Content="&#x8FDE;&#x63A5;"
                                    Style="{StaticResource PrimaryButton}"
                                    Background="{StaticResource AccentGreen}"
                                    BorderBrush="#16723F"
                                    Click="ConnectFeeder_Click" />
                            <Button Content="&#x65AD;&#x5F00;"
                                    Style="{StaticResource PrimaryButton}"
                                    Background="#294A64"
                                    BorderBrush="#45647A"
                                    Margin="0"
                                    Click="DisconnectFeeder_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="560" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="220" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="156" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource PanelHeader}"
                                    BorderBrush="{StaticResource PanelBorder}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="6,6,0,0"
                                    Padding="14,0">
                                <TextBlock Text="TCP &#x5BA2;&#x6237;&#x7AEF;&#x53C2;&#x6570;" Style="{StaticResource PanelTitle}" />
                            </Border>

                            <Grid Grid.Row="1" Margin="14,12,14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="42" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="&#x8BBE;&#x5907;&#x5730;&#x5740;" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="0"
                                             Grid.Column="1"
                                             Style="{StaticResource ConfigInput}"
                                             Text="{Binding FeederSettings.Host, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="TCP &#x7AEF;&#x53E3;" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="0"
                                             Grid.Column="4"
                                             Style="{StaticResource ConfigInput}"
                                             Text="{Binding FeederSettings.Port, UpdateSourceTrigger=LostFocus}" />

                                    <TextBlock Grid.Row="1" Text="&#x7ED3;&#x675F;&#x7B26;" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="1"
                                             Grid.Column="1"
                                             Grid.ColumnSpan="4"
                                             Style="{StaticResource ConfigInput}"
                                             Text="{Binding FeederSettings.NewLine, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" />
                                <RowDefinition Height="64" />
                                <RowDefinition Height="48" />
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource PanelHeader}"
                                    BorderBrush="{StaticResource PanelBorder}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="6,6,0,0"
                                    Padding="14,0">
                                <TextBlock Text="&#x5149;&#x6E90;&#x63A7;&#x5236;" Style="{StaticResource PanelTitle}" />
                            </Border>

                            <Grid Grid.Row="1" Margin="14,8,14,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="22" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#x5149;&#x6E90;&#x4EAE;&#x5EA6;" Style="{StaticResource FieldLabel}" />
                                <Button Grid.Column="1"
                                        Content="&#x2212;"
                                        ToolTip="&#x4EAE;&#x5EA6;&#x51CF; 1"
                                        Style="{StaticResource BrightnessStepButton}"
                                        Click="DecreaseLightBrightness_Click" />
                                <Slider x:Name="LightBrightnessSlider"
                                        Grid.Column="3"
                                        Minimum="0"
                                        Maximum="99"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True"
                                        AutoToolTipPlacement="TopLeft"
                                        AutoToolTipPrecision="0"
                                        Style="{StaticResource BrightnessSlider}"
                                        VerticalAlignment="Center"
                                        Value="{Binding FeederSettings.LightOnBrightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ValueChanged="LightBrightnessSlider_ValueChanged" />
                                <Button Grid.Column="5"
                                        Content="+"
                                        ToolTip="&#x4EAE;&#x5EA6;&#x52A0; 1"
                                        Style="{StaticResource BrightnessStepButton}"
                                        Click="IncreaseLightBrightness_Click" />
                                <TextBox Grid.Column="7"
                                         Height="34"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Center"
                                         Padding="4,0"
                                         Style="{StaticResource ConfigInput}"
                                         BorderBrush="{StaticResource AccentBlue}"
                                         BorderThickness="2"
                                         FontWeight="Bold"
                                         Text="{Binding FeederSettings.LightOnBrightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="8"
                                           Text="%"
                                           Margin="5,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedText}"
                                           FontWeight="SemiBold" />
                            </Grid>

                            <Grid Grid.Row="2" Margin="14,2,14,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="&#x5149;&#x6E90;&#x5F00;"
                                            Height="34"
                                            MinWidth="76"
                                            Style="{StaticResource PrimaryButton}"
                                            Background="{StaticResource AccentGreen}"
                                            BorderBrush="#16723F"
                                            Click="LightOn_Click" />
                                    <Button Content="&#x5149;&#x6E90;&#x5173;"
                                            Height="34"
                                            MinWidth="76"
                                            Style="{StaticResource PrimaryButton}"
                                            Background="{StaticResource AccentRed}"
                                            BorderBrush="#A90A12"
                                            Margin="0"
                                            Click="LightOff_Click" />
                                </StackPanel>
                            </Grid>

                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="44" />
                                <RowDefinition Height="52" />
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource PanelHeader}"
                                    BorderBrush="{StaticResource PanelBorder}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="6,6,0,0"
                                    Padding="14,0">
                                <TextBlock Text="&#x6570;&#x636E;&#x6536;&#x53D1;" Style="{StaticResource PanelTitle}" />
                            </Border>

                            <TextBox Grid.Row="1"
                                     Margin="14,12,14,0"
                                     Padding="10,8"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     BorderBrush="#45647A"
                                     Background="#132B40"
                                     Foreground="#F4F8FB"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     Text="{Binding FeederSettings.ManualSendText, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Grid.Row="2" Margin="14,10,14,0">
                                <CheckBox
                                          Style="{StaticResource ConfigCheckBox}"
                                          Content="&#x53D1;&#x9001;&#x65F6;&#x8FFD;&#x52A0;&#x7ED3;&#x675F;&#x7B26;"
                                          IsChecked="{Binding FeederSettings.AppendNewLine, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <StackPanel Grid.Row="3"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="14,8,6,12">
                                <Button Content="&#x53D1;&#x9001;"
                                        Style="{StaticResource PrimaryButton}"
                                        Background="{StaticResource AccentGreen}"
                                        BorderBrush="#16723F"
                                        Click="SendManualMessage_Click" />
                                <Button Content="&#x4E00;&#x952E;&#x9707;&#x52A8;"
                                        Style="{StaticResource PrimaryButton}"
                                        Background="{StaticResource AccentBlue}"
                                        BorderBrush="#0B5CC2"
                                        Click="OneKeyVibration_Click" />
                                <Button Content="&#x505C;&#x6B62;&#x9707;&#x52A8;"
                                        Style="{StaticResource PrimaryButton}"
                                        Background="{StaticResource AccentRed}"
                                        BorderBrush="#A90A12"
                                        Click="StopVibration_Click" />
                                <Button Content="&#x6E05;&#x7A7A;&#x65E5;&#x5FD7;"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="ClearLog_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    </Grid>

                <Border Grid.Column="2" Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource PanelHeader}"
                                BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="6,6,0,0"
                                Padding="14,0">
                            <TextBlock Text="&#x901A;&#x8BAF;&#x65E5;&#x5FD7;" Style="{StaticResource PanelTitle}" />
                        </Border>

                        <ListBox x:Name="ConnectionLogListBox"
                                 Grid.Row="1"
                                 ItemsSource="{Binding FeederConnectionLogs}"
                                 BorderThickness="0"
                                 Background="#132B40"
                                 Padding="8"
                                 FontSize="13">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Foreground="#D8E4EC"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
