<UserControl x:Class="ControlHub.Views.Pages.ConnectionConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="680"
             Loaded="ConnectionConfigPage_Loaded"
             Unloaded="ConnectionConfigPage_Unloaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBorder" Color="#345269" />
        <SolidColorBrush x:Key="PanelFill" Color="#163047" />
        <SolidColorBrush x:Key="PanelHeader" Color="#1B374F" />
        <SolidColorBrush x:Key="AccentBlue" Color="#0D6EE8" />
        <SolidColorBrush x:Key="AccentGreen" Color="#1B8F4D" />
        <SolidColorBrush x:Key="AccentRed" Color="#D90D16" />
        <SolidColorBrush x:Key="MutedText" Color="#AAB9C6" />
        <SolidColorBrush x:Key="DarkText" Color="#F4F8FB" />

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F8FB" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#AAB9C6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="ConfigInput" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#45647A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#132B40" />
            <Setter Property="Foreground" Value="#F4F8FB" />
        </Style>

        <Style x:Key="ConfigComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F4F8FB" />
            <Setter Property="Background" Value="#132B40" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0C4C88" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0D6EE8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfigComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#45647A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#132B40" />
            <Setter Property="Foreground" Value="#F4F8FB" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ConfigComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="9,0,4,0"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Border Grid.Column="1"
                                                        Background="#1B374F"
                                                        BorderBrush="#45647A"
                                                        BorderThickness="1,0,0,0">
                                                    <Path Width="10"
                                                          Height="6"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Fill="#A9C7DC"
                                                          Data="M 0 0 L 5 5 L 10 0 Z" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#0D6EE8" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#62B5FF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Margin="0,2,0,0"
                                        Background="#132B40"
                                        BorderBrush="#45647A"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBlue}" />
            <Setter Property="BorderBrush" Value="#0B5CC2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="#F4F8FB" />
            <Setter Property="Background" Value="#294A64" />
            <Setter Property="BorderBrush" Value="#45647A" />
        </Style>

        <Style x:Key="DirectionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Background" Value="#294A64" />
            <Setter Property="BorderBrush" Value="#45647A" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="ConnectionItem" TargetType="Border">
            <Setter Property="Height" Value="74" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Background" Value="#1B374F" />
            <Setter Property="BorderBrush" Value="#345269" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="ActiveConnectionItem" TargetType="Border" BasedOn="{StaticResource ConnectionItem}">
            <Setter Property="Background" Value="#0C4C88" />
            <Setter Property="BorderBrush" Value="#0D6EE8" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DarkText}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ConfigCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D8E4EC" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="BrightnessStepButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#62B5FF" />
            <Setter Property="Background" Value="#294A64" />
            <Setter Property="BorderBrush" Value="#45647A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#365C78" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0D6EE8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0D6EE8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrightnessSlider" TargetType="Slider">
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="36" VerticalAlignment="Center">
                            <Border Height="12"
                                    VerticalAlignment="Center"
                                    Background="#294A64"
                                    BorderBrush="#45647A"
                                    BorderThickness="1"
                                    CornerRadius="6" />
                            <Track x:Name="PART_Track"
                                   Height="26"
                                   VerticalAlignment="Center"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="12"
                                                        VerticalAlignment="Center"
                                                        Background="#0D6EE8"
                                                        CornerRadius="6,0,0,6" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="24" Height="24" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="#F7FAFC"
                                                             Stroke="#0D6EE8"
                                                             StrokeThickness="3" />
                                                    <Ellipse Width="8" Height="8" Fill="#0D6EE8" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="1.08" ScaleY="1.08" />
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10,10,10,8" Background="#10263A">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource Panel}"
                Background="#163047"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="&#x8FDE;&#x63A5;&#x914D;&#x7F6E;&#x4E2D;&#x5FC3;"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#F4F8FB" />
                </StackPanel>

                <Border Grid.Column="1"
                        Height="42"
                        Padding="12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#132B40"
                        BorderBrush="#345269"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#39C56B" Margin="0,0,10,0" />
                        <TextBlock x:Name="ActiveConnectionStatusText"
                                   Text="{Binding FeederConnectionStatusText}"
                                   Width="286"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#62B5FF"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="&#x8FDE;&#x63A5;&#x5BF9;&#x8C61;" Style="{StaticResource PanelTitle}" />

                    <StackPanel Grid.Row="1">
                        <Border x:Name="FeederConnectionItem"
                                Style="{StaticResource ActiveConnectionItem}"
                                Cursor="Hand"
                                MouseLeftButtonDown="FeederConnectionItem_MouseLeftButtonDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        Background="#0D6EE8"
                                        CornerRadius="4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="TCP"
                                               Foreground="White"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="&#x9707;&#x52A8;&#x76D8;"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#F4F8FB" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#62B5FF">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="TCP  {0}:{1}">
                                                <Binding Path="FeederSettings.Host" />
                                                <Binding Path="FeederSettings.Port" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="TcpConnectionItem"
                                Style="{StaticResource ConnectionItem}"
                                Cursor="Hand"
                                MouseLeftButtonDown="TcpConnectionItem_MouseLeftButtonDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        Background="#1B8F4D"
                                        CornerRadius="4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="TCP"
                                               Foreground="White"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="E4981A 仪表"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#F4F8FB" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#62B5FF">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="SCPI  {0}:{1}">
                                                <Binding Path="TcpConnectionSettings.Host" />
                                                <Binding Path="TcpConnectionSettings.Port" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="SerialConnectionItem"
                                Style="{StaticResource ConnectionItem}"
                                Cursor="Hand"
                                MouseLeftButtonDown="SerialConnectionItem_MouseLeftButtonDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        Background="#8C5FD3"
                                        CornerRadius="4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="COM"
                                               Foreground="White"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="SM7110 仪表"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#F4F8FB" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#62B5FF">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}  {1} bps">
                                                <Binding Path="SerialConnectionSettings.PortName" />
                                                <Binding Path="SerialConnectionSettings.BaudRate" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>

                </Grid>
            </Border>

            <Grid x:Name="FeederDetailPanel" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="82" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="330" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#x8BBE;&#x5907;" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="&#x9707;&#x52A8;&#x76D8;" Style="{StaticResource MetricValue}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="&#x8BBE;&#x5907;&#x5730;&#x5740;" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding FeederSettings.Host}" Style="{StaticResource MetricValue}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="TCP &#x7AEF;&#x53E3;" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding FeederSettings.Port}" Style="{StaticResource MetricValue}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock Text="&#x534F;&#x8BAE;" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="TCP Client" Style="{StaticResource MetricValue}" Margin="0,6,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="4"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Content="&#x4FDD;&#x5B58;"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="SaveSettings_Click" />
                            <Button Content="&#x8FDE;&#x63A5;"
                                    Style="{StaticResource PrimaryButton}"
                                    Background="{StaticResource AccentGreen}"
                                    BorderBrush="#16723F"
                                    Click="ConnectFeeder_Click" />
                            <Button Content="&#x65AD;&#x5F00;"
                                    Style="{StaticResource PrimaryButton}"
                                    Background="#294A64"
                                    BorderBrush="#45647A"
                                    Margin="0"
                                    Click="DisconnectFeeder_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="560" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="0,0,4,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                    <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource PanelHeader}"
                                    BorderBrush="{StaticResource PanelBorder}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="6,6,0,0"
                                    Padding="14,0">
                                <TextBlock Text="TCP &#x5BA2;&#x6237;&#x7AEF;&#x53C2;&#x6570;" Style="{StaticResource PanelTitle}" />
                            </Border>

                            <Grid Grid.Row="1" Margin="14,12,14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="42" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="&#x8BBE;&#x5907;&#x5730;&#x5740;" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="0"
                                             Grid.Column="1"
                                             Style="{StaticResource ConfigInput}"
                                             Text="{Binding FeederSettings.Host, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="TCP &#x7AEF;&#x53E3;" Style="{StaticResource FieldLabel}" />
