                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="#D8E4EC"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
