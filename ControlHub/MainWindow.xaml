<Window x:Class="ControlHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="16轴运动控制系统"
        Width="1680"
        Height="950"
        MinWidth="1280"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#D7DDE5"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="TopBar" Color="#071827" />
        <SolidColorBrush x:Key="TopBar2" Color="#12283E" />
        <SolidColorBrush x:Key="MenuBlue" Color="#1F5F9F" />
        <SolidColorBrush x:Key="PanelBorder" Color="#B9C1CB" />
        <SolidColorBrush x:Key="PanelTitle" Color="#003B73" />
        <SolidColorBrush x:Key="DarkText" Color="#101827" />

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#F3F6FA" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PanelTitle}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Foreground" Value="#EAF2FA" />
            <Setter Property="Background" Value="#20384F" />
            <Setter Property="BorderBrush" Value="#4D6478" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#284A68" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#17324A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveMenuButton" TargetType="Button" BasedOn="{StaticResource MenuButton}">
            <Setter Property="Background" Value="{StaticResource MenuBlue}" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="128" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#C9D7E4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.24" Color="#334155" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AxisButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Background" Value="#EEF2F6" />
            <Setter Property="BorderBrush" Value="#CBD2DA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E1E7ED" />
                                <Setter Property="BorderBrush" Value="#AEB8C3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D6DEE7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="{StaticResource DarkText}" />
            <Setter Property="BorderBrush" Value="#CBD2DA" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="#CDD3DA" />
            <Setter Property="VerticalGridLinesBrush" Value="#CDD3DA" />
            <Setter Property="RowBackground" Value="#F8FAFC" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="RowHeight" Value="31" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF2F6" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#CBD2DA" />
            <Setter Property="BorderThickness" Value="0,1,1,1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CenteredDataGridText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="2,0" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Background="#E8EDF2">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="132" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource TopBar}" BorderBrush="#25435E" BorderThickness="0,0,0,1">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="560" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="350" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="▰" Foreground="#E6EEF6" FontSize="28" FontWeight="Bold" Margin="0,0,16,0" />
                        <TextBlock Text="16轴运动控制系统" Foreground="White" FontSize="25" FontWeight="Bold" />
                        <Border Width="1" Height="24" Background="#44627D" Margin="20,0,18,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="当前配方" Foreground="#AFC1D2" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="产品A_20240520" Foreground="#F2F7FB" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="运行状态：" Foreground="#E8F0F7" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="运行中" Foreground="#00FF4C" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,42,0" />
                        <TextBlock Text="急停状态：" Foreground="#E8F0F7" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="正常" Foreground="#00FF4C" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="用户权限： 工程师" Foreground="#F2F7FB" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="{Binding NowText}" Foreground="#F2F7FB" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="15" FontWeight="Bold" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource TopBar2}" Padding="14,4,14,4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource MenuButton}">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="20"
                                   Height="20"
                                   Margin="0,0,8,0"
                                   Source="/Assets/Icons/TopMenu/home.png"
                                   Stretch="Uniform" />
                            <TextBlock Text="主页" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Content="运动控制" Style="{StaticResource ActiveMenuButton}" />
                    <Button Content="I/O监控" Style="{StaticResource MenuButton}" />
                    <Button Content="参数设置" Style="{StaticResource MenuButton}" />
                    <Button Content="报警记录" Style="{StaticResource MenuButton}" />
                    <Button Content="配方管理" Style="{StaticResource MenuButton}" />
                    <Button Content="权限登录" Style="{StaticResource MenuButton}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="10,10,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.02*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.08*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="AxisStatusPanel" Grid.Column="0" Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="▌ 轴状态监控（16轴）" Style="{StaticResource SectionTitle}" />
                        <DataGrid x:Name="AxisDataGrid"
                                  Grid.Row="1"
                                  ItemsSource="{Binding Axes}"
                                  SelectedItem="{Binding SelectedAxis}"
                                  AlternationCount="2"
                                  AlternatingRowBackground="#F8FAFC"
                                  RowHeight="34"
                                  Loaded="AxisDataGrid_LayoutChanged"
                                  SizeChanged="AxisDataGrid_LayoutChanged"
                                  LostKeyboardFocus="AxisDataGrid_LostKeyboardFocus"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="轴号" Binding="{Binding AxisNo}" Width="0.55*" ElementStyle="{StaticResource CenteredDataGridText}" />
                                <DataGridTextColumn Header="轴名称" Binding="{Binding Name}" Width="0.72*" ElementStyle="{StaticResource CenteredDataGridText}" />
                                <DataGridTextColumn Header="当前位置(mm/°)" Binding="{Binding DisplayPosition}" Width="1.28*" ElementStyle="{StaticResource CenteredDataGridText}" />
                                <DataGridTextColumn Header="目标位置(mm/°)" Binding="{Binding DisplayTarget}" Width="1.28*" ElementStyle="{StaticResource CenteredDataGridText}" />
                                <DataGridTextColumn Header="速度(mm/s/°/s)" Binding="{Binding DisplaySpeed}" Width="1.25*" ElementStyle="{StaticResource CenteredDataGridText}" />
                                <DataGridTemplateColumn Header="伺服状态" Width="0.95*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse Width="12" Height="12" Fill="{Binding ServoBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding ServoText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="报警状态" Width="0.92*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse Width="12" Height="12" Fill="{Binding AlarmBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding AlarmText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="正限位" Width="0.62*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="12" Height="12" Fill="{Binding PositiveLimitBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="负限位" Width="0.62*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="12" Height="12" Fill="{Binding NegativeLimitBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="回零" Width="0.68*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="回零" Style="{StaticResource AxisButton}" Click="Home_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="点动+" Width="0.72*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="点动+" Style="{StaticResource AxisButton}" Click="JogPositive_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="点动-" Width="0.72*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="点动-" Style="{StaticResource AxisButton}" Click="JogNegative_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="停止" Width="0.68*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="停止" Style="{StaticResource AxisButton}" Click="Stop_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="292" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="▌ I/O监控" Style="{StaticResource SectionTitle}" />
                            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,6">
                                <Border Background="#1E5EA8" BorderBrush="#9FB7D5" BorderThickness="1"><TextBlock Text="数字输入(X)" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <Border Background="#F0F3F6" BorderBrush="#B9C1CB" BorderThickness="1"><TextBlock Text="数字输出(Y)" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <Border Background="#F0F3F6" BorderBrush="#B9C1CB" BorderThickness="1"><TextBlock Text="模拟输入(AI)" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <Border Background="#F0F3F6" BorderBrush="#B9C1CB" BorderThickness="1"><TextBlock Text="模拟输出(AO)" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            </UniformGrid>
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding IoPoints}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="16" Rows="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,5" />
                                            <Ellipse Width="15" Height="15" Fill="{Binding LampBrush}" Stroke="#6B7280" StrokeThickness="1" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="▌ 报警记录" Style="{StaticResource SectionTitle}" FontSize="14" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding AlarmRecords}" RowHeight="29" FontSize="11">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="1.4*" MinWidth="142" ElementStyle="{StaticResource CenteredDataGridText}" />
                                    <DataGridTextColumn Header="报警代码" Binding="{Binding Code}" Width="0.9*" ElementStyle="{StaticResource CenteredDataGridText}" />
                                    <DataGridTextColumn Header="报警信息" Binding="{Binding Message}" Width="1.8*" ElementStyle="{StaticResource CenteredDataGridText}" />
                                    <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="0.55*" ElementStyle="{StaticResource CenteredDataGridText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="3"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    Margin="10,4,10,8"
                    Padding="16,6,14,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="▌ 操作面板" Style="{StaticResource SectionTitle}" Margin="0" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="590" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,10,0">
                            <Button Background="#00A619" Style="{StaticResource ActionButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="24"
                                           Height="24"
                                           Margin="0,0,8,0"
                                           Source="/Assets/Icons/ControlPanel/start.png"
                                           Stretch="Uniform" />
                                    <TextBlock Text="启动" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Background="#BC100B" Style="{StaticResource ActionButton}" Click="Stop_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="24"
                                           Height="24"
                                           Margin="0,0,8,0"
                                           Source="/Assets/Icons/ControlPanel/stop.png"
                                           Stretch="Uniform" />
                                    <TextBlock Text="停止" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Background="#1F5F9F" Style="{StaticResource ActionButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="24"
                                           Height="24"
                                           Margin="0,0,8,0"
                                           Source="/Assets/Icons/ControlPanel/reset.png"
                                           Stretch="Uniform" />
                                    <TextBlock Text="复位" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Background="#E97906" Style="{StaticResource ActionButton}" Click="Home_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="24"
                                           Height="24"
                                           Margin="0,0,8,0"
                                           Source="/Assets/Icons/ControlPanel/home.png"
                                           Stretch="Uniform" />
                                    <TextBlock Text="回原点" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Background="#1F5F9F" Style="{StaticResource ActionButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="24"
                                           Height="24"
                                           Margin="0,0,8,0"
                                           Source="/Assets/Icons/ControlPanel/auto-mode.png"
                                           Stretch="Uniform" />
                                    <TextBlock Text="自动运行" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Background="#1F5F9F" Style="{StaticResource ActionButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="24"
                                           Height="24"
                                           Margin="0,0,8,0"
                                           Source="/Assets/Icons/ControlPanel/manual-mode.png"
                                           Stretch="Uniform" />
                                    <TextBlock Text="手动模式" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Background="#1F5F9F" Style="{StaticResource ActionButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="24"
                                           Height="24"
                                           Margin="0,0,8,0"
                                           Source="/Assets/Icons/ControlPanel/clear-alarm.png"
                                           Stretch="Uniform" />
                                    <TextBlock Text="报警清除" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <UniformGrid Grid.Column="1" Columns="5" Margin="0,0,4,0">
                            <Border Background="#F8FAFC" BorderBrush="#D0D6DE" BorderThickness="1" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border BorderBrush="#D0D6DE" BorderThickness="0,0,0,1">
                                        <TextBlock Text="程序状态" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="就绪" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#168500" FontSize="16" FontWeight="Bold" />
                                </Grid>
                            </Border>
                            <Border Background="#F8FAFC" BorderBrush="#D0D6DE" BorderThickness="1" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border BorderBrush="#D0D6DE" BorderThickness="0,0,0,1">
                                        <TextBlock Text="运行时间" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="00:12:45" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" />
                                </Grid>
                            </Border>
                            <Border Background="#F8FAFC" BorderBrush="#D0D6DE" BorderThickness="1" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border BorderBrush="#D0D6DE" BorderThickness="0,0,0,1">
                                        <TextBlock Text="节拍时间" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="12.35 s" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" />
                                </Grid>
                            </Border>
                            <Border Background="#F8FAFC" BorderBrush="#D0D6DE" BorderThickness="1" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border BorderBrush="#D0D6DE" BorderThickness="0,0,0,1">
                                        <TextBlock Text="加工数量" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                                    </Border>
